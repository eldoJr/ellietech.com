---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import Button from '../components/ui/button.astro';
---

<BaseLayout title="404 — Page Not Found | EllieTech">
  <Header />
  <main class="flex flex-1 items-center justify-center px-6 py-32">
    <div class="text-center">
      <p class="mb-4 text-7xl font-bold text-primary/30">404</p>
      <h1 class="mb-4 text-2xl font-bold">Page not found</h1>
      <p class="mb-8 text-text-secondary">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <Button variant="primary" href="/">
        Back to Home
      </Button>
    </div>
  </main>
  <Footer />
</BaseLayout>
