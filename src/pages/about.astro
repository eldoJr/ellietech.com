---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderWrapper from '../components/header-wrapper.astro';
import Footer from '../components/footer.astro';
import AboutHero from '../components/sections/about/hero.astro';
import HowWeWork from '../components/sections/about/how-we-work.astro';
import Team from '../components/sections/about/team.astro';
import TechStack from '../components/sections/about/tech-stack.astro';
import Values from '../components/sections/about/values.astro';
import Contact from '../components/sections/contact.astro';
import BackToTop from '../components/common/back-to-top.astro';
---

<BaseLayout title="About us — EllieTech">
  <HeaderWrapper />
  <main id="main-content">
    <AboutHero />
    <HowWeWork />
    <Team />
    <TechStack />
    <Values />
    <Contact />
  </main>
  <Footer />
  <BackToTop />
</BaseLayout>

<script>
  // Handle hash navigation on page load
  document.addEventListener('DOMContentLoaded', () => {
    if (window.location.hash) {
      setTimeout(() => {
        const element = document.querySelector(window.location.hash);
        if (element) {
          element.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, 100);
    }
  });
</script>
