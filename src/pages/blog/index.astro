---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderWrapper from '../../components/header-wrapper.astro';
import Footer from '../../components/footer.astro';
import Card from '../../components/ui/card.astro';
import Badge from '../../components/ui/badge.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog — EllieTech" description="Insights on full-stack development, AI systems, and modern engineering practices.">
  <HeaderWrapper />
  <main class="px-6 pb-32 pt-32">
    <div class="mx-auto max-w-7xl">
      <div class="mb-16 max-w-2xl">
        <Badge variant="primary" class="mb-4">Blog</Badge>
        <h1 class="mb-4 text-3xl font-bold tracking-tight sm:text-4xl">
          Insights & Engineering Notes
        </h1>
        <p class="text-lg text-text-secondary">
          Thoughts on building modern software, AI systems, and scaling digital products.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post) => (
            <a href={`/blog/${post.id}`} class="group">
              <Card class="flex h-full flex-col">
                <div class="mb-3 flex flex-wrap gap-2">
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <span class="rounded-md bg-surface px-2 py-1 text-xs text-text-muted">{tag}</span>
                  ))}
                </div>
                <h2 class="mb-2 text-lg font-semibold group-hover:text-primary transition-colors">
                  {post.data.title}
                </h2>
                <p class="mb-4 flex-1 text-sm leading-relaxed text-text-secondary">
                  {post.data.description}
                </p>
                <time class="text-xs text-text-muted" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              </Card>
            </a>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
