---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import Hero from '../components/sections/hero.astro';
import Services from '../components/sections/services.astro';
import Work from '../components/sections/work.astro';
import WhyUs from '../components/sections/why-us.astro';
import MiniCTA2 from '../components/sections/mini-cta-2.astro';
import Process from '../components/sections/process.astro';
import TechStack from '../components/sections/tech-stack.astro';
import Industries from '../components/sections/industries.astro';
import MiniCTA from '../components/sections/mini-cta.astro';
import Testimonials from '../components/sections/testimonials.astro';
import FAQ from '../components/sections/faq.astro';
import Contact from '../components/sections/contact.astro';
import BackToTop from '../components/common/back-to-top.astro';
---

<BaseLayout title="EllieTech — Modern Engineering Studio">
  <Header />
  <main id="main-content">
    <Hero />
    <Services />
    <TechStack />
    <Industries />
    <MiniCTA />
    <Process />
    <Work />
    <WhyUs />
    <Testimonials />
    <MiniCTA2 />
    <FAQ />
    <Contact />
  </main>
  <Footer />
  <BackToTop />
</BaseLayout>
