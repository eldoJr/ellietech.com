---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import Hero from '../components/sections/hero.astro';
import Services from '../components/sections/services.astro';
import Work from '../components/sections/work.astro';
import Process from '../components/sections/process.astro';
import TechStack from '../components/sections/tech-stack.astro';
import Testimonials from '../components/sections/testimonials.astro';
import About from '../components/sections/about.astro';
import FAQ from '../components/sections/faq.astro';
import CTA from '../components/sections/cta.astro';
import Contact from '../components/sections/contact.astro';
import BackToTop from '../components/common/back-to-top.astro';
---

<BaseLayout title="EllieTech — Modern Engineering Studio">
  <Header />
  <main id="main-content">
    <Hero />
    <Services />
    <Process />
    <Work />
    <TechStack />
    <Testimonials />
    <About />
    <FAQ />
    <CTA />
    <Contact />
  </main>
  <Footer />
  <BackToTop />
</BaseLayout>
