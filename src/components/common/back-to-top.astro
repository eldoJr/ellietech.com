---

<button
  id="back-to-top"
  class="fixed bottom-8 right-8 z-50 hidden h-10 w-10 items-center justify-center rounded-full border border-border/50 bg-surface-light text-text-secondary shadow-lg transition-all hover:bg-surface-elevated hover:text-text-primary"
  aria-label="Back to top"
>
  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
  </svg>
</button>

<script>
  const btn = document.getElementById('back-to-top');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 500) {
      btn?.classList.remove('hidden');
      btn?.classList.add('flex');
    } else {
      btn?.classList.add('hidden');
      btn?.classList.remove('flex');
    }
  });

  btn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
