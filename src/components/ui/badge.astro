---
interface Props {
  variant?: 'default' | 'primary' | 'accent';
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;

const variants = {
  default: 'border-border/80 text-text-secondary bg-surface-elevated',
  primary: 'border-primary/30 text-primary bg-primary/10',
  accent: 'border-accent/30 text-accent bg-accent/10',
};

const classes = [
  'inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium',
  variants[variant],
  className,
].filter(Boolean).join(' ');
---

<span class={classes}>
  <slot />
</span>
