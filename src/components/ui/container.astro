---
interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
}

const { class: className, size = 'xl' } = Astro.props;

const sizes = {
  sm: 'max-w-3xl',
  md: 'max-w-5xl',
  lg: 'max-w-7xl',
  xl: 'max-w-7xl',
};
---

<div class:list={['mx-auto px-6', sizes[size], className]}>
  <slot />
</div>
