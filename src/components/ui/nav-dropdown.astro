---
interface Props {
  label: string;
  href?: string;
}

const { label, href = '#' } = Astro.props;
---

<div class="nav-dropdown-trigger relative flex items-stretch h-full" data-dropdown>
  <a
    href={href}
    class="nav-dropdown-label flex items-center gap-1 text-sm text-text-secondary transition-colors duration-200 relative"
    data-dropdown-label
  >
    {label}
    <svg class="nav-dropdown-chevron h-3 w-3 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </a>

  <!-- Dropdown panel -->
  <div
    class="nav-dropdown-panel fixed left-0 right-0 z-[100] overflow-hidden"
    data-dropdown-panel
  >
    <div class="nav-dropdown-inner bg-gradient-to-b from-[rgba(25,25,35,0.98)] to-[rgba(15,15,22,0.98)] border-b border-white/[0.08] shadow-[0_4px_24px_rgba(0,0,0,0.5),inset_0_0_0_1px_rgba(255,255,255,0.03)]">
      <div class="mx-auto max-w-[1320px] px-8 py-8">
        <slot />
      </div>
    </div>
  </div>
</div>

<style>
  /* Orange underline — rendered via ::after on the label */
  .nav-dropdown-label::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: #ff6b35;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-dropdown-trigger:hover .nav-dropdown-label::after,
  .nav-dropdown-trigger.is-open .nav-dropdown-label::after {
    transform: scaleX(1);
  }

  /* Panel hidden state */
  .nav-dropdown-panel {
    pointer-events: none;
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transition: visibility 0s 0.35s, clip-path 0s 0.35s;
  }

  .nav-dropdown-inner {
    opacity: 0;
    transform: translateY(-100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.15s ease;
  }

  /* Panel open state — paper slide down */
  .nav-dropdown-trigger.is-open .nav-dropdown-panel {
    pointer-events: auto;
    visibility: visible;
    clip-path: inset(0 0 0 0);
    transition: visibility 0s 0s, clip-path 0s 0s;
  }

  .nav-dropdown-trigger.is-open .nav-dropdown-inner {
    opacity: 1;
    transform: translateY(0);
  }

  /* Label hover — orange */
  .nav-dropdown-trigger:hover .nav-dropdown-label,
  .nav-dropdown-trigger.is-open .nav-dropdown-label {
    color: #ff6b35;
  }

  .nav-dropdown-trigger.is-open .nav-dropdown-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const triggers = document.querySelectorAll<HTMLElement>('[data-dropdown]');
    let activeTimeout: ReturnType<typeof setTimeout>;

    triggers.forEach((trigger) => {
      const panel = trigger.querySelector<HTMLElement>('[data-dropdown-panel]');

      const setPosition = () => {
        const mainNav = document.getElementById('main-nav');
        if (mainNav && panel) {
          const rect = mainNav.getBoundingClientRect();
          panel.style.top = `${rect.bottom}px`;
        }
      };

      const open = () => {
        clearTimeout(activeTimeout);
        triggers.forEach((t) => {
          if (t !== trigger) t.classList.remove('is-open');
        });
        setPosition();
        trigger.classList.add('is-open');
      };

      const close = () => {
        activeTimeout = setTimeout(() => {
          trigger.classList.remove('is-open');
        }, 100);
      };

      trigger.addEventListener('mouseenter', open);
      trigger.addEventListener('mouseleave', close);

      panel?.addEventListener('mouseenter', () => {
        clearTimeout(activeTimeout);
        trigger.classList.add('is-open');
      });
      panel?.addEventListener('mouseleave', close);

      // Keyboard accessibility
      const label = trigger.querySelector<HTMLElement>('[data-dropdown-label]');
      label?.addEventListener('focus', open);
      label?.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          trigger.classList.remove('is-open');
          label.blur();
        }
      });
    });

    // Close all on scroll
    window.addEventListener('scroll', () => {
      triggers.forEach((t) => t.classList.remove('is-open'));
    }, { passive: true });
  });
</script>
