---
interface Props {
  src?: string;
  alt: string;
  size?: 'sm' | 'md' | 'lg';
  initials?: string;
}

const { src, alt, size = 'md', initials } = Astro.props;

const sizes = {
  sm: 'h-8 w-8 text-xs',
  md: 'h-10 w-10 text-sm',
  lg: 'h-14 w-14 text-base',
};
---

{src ? (
  <img
    src={src}
    alt={alt}
    class:list={['rounded-full object-cover border border-border/50', sizes[size]]}
  />
) : (
  <div class:list={['flex items-center justify-center rounded-full bg-surface-elevated border border-border/50 font-medium text-text-secondary', sizes[size]]}>
    {initials || alt.charAt(0).toUpperCase()}
  </div>
)}
