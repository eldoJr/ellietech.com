---
interface Props {
  name: string;
  position: string;
  academic: string;
  avatarUrl: string;
  bio?: string;
  linkedin?: string;
  github?: string;
  portfolio?: string;
}

const { name, position, academic, avatarUrl, bio, linkedin, github, portfolio } = Astro.props;
---

<div class="profile-card">
  <!-- Image -->
  <div class="profile-card__image">
    <img src={avatarUrl} alt={name} loading="lazy" />
  </div>

  <!-- Content -->
  <div class="profile-card__content">
    <h3 class="profile-card__name">{name}</h3>
    <p class="profile-card__position">{position}</p>
    {bio && <p class="profile-card__bio">{bio}</p>}
    <p class="profile-card__academic">{academic}</p>

    <!-- Links -->
    <div class="profile-card__links">
      {linkedin && (
        <a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        </a>
      )}
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
      )}
      {portfolio && (
        <a href={portfolio} target="_blank" rel="noopener noreferrer" aria-label="Portfolio">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .profile-card {
    max-width: 320px;
    width: 100%;
  }

  .profile-card__image {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .profile-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    filter: grayscale(1) contrast(1.05);
  }

  .profile-card:hover .profile-card__image img {
    filter: grayscale(0) contrast(1);
  }

  .profile-card__content {
    padding: 1.5rem 0.25rem;
  }

  .profile-card__name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary, #1a1a1a);
    margin: 0;
    line-height: 1.3;
    opacity: 0.7;
  }

  .profile-card:hover .profile-card__name {
    opacity: 1;
    color: #ff6b35;
  }

  .profile-card__position {
    font-size: 0.85rem;
    font-style: italic;
    font-weight: 400;
    color: var(--color-text-secondary, rgba(255, 255, 255, 0.6));
    margin: 0.35rem 0 0;
  }

  .profile-card__bio {
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-text-muted, rgba(255, 255, 255, 0.45));
    margin: 1rem 0 0;
  }

  .profile-card__academic {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-text-muted, rgba(255, 255, 255, 0.35));
    margin: 0.75rem 0 0;
    letter-spacing: 0.01em;
  }

  .profile-card__links {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .profile-card__links a {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.4);
  }

  .profile-card__links a:hover {
    color: #ff6b35;
  }

  .profile-card__links svg {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
