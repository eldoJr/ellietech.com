---
const categories = [
  {
    name: 'Frontend',
    tools: ['React', 'Next.js', 'Astro', 'Vue', 'Angular', 'TypeScript', 'Tailwind CSS', 'Svelte', 'Remix'],
  },
  {
    name: 'Backend',
    tools: ['Node.js', 'Python', 'Go', 'Java', '.NET', 'GraphQL', 'REST', 'gRPC', 'Rust'],
  },
  {
    name: 'Mobile',
    tools: ['React Native', 'Flutter', 'iOS (Swift)', 'Android (Kotlin)', 'Xamarin', '.NET MAUI', 'Expo'],
  },
  {
    name: 'AI / ML',
    tools: ['TensorFlow', 'PyTorch', 'OpenAI', 'LangChain', 'Hugging Face', 'Scikit-learn', 'RAG', 'MLflow'],
  },
  {
    name: 'Cloud & DevOps',
    tools: ['AWS', 'GCP', 'Azure', 'Docker', 'Kubernetes', 'Terraform', 'CI/CD', 'GitHub Actions', 'ArgoCD'],
  },
  {
    name: 'Data',
    tools: ['PostgreSQL', 'Redis', 'MongoDB', 'Elasticsearch', 'Kafka', 'Supabase', 'Prisma', 'DynamoDB'],
  },
];
---

<section id="tech-stack" class="px-6 py-32">
  <div class="mx-auto max-w-[1440px] px-0 md:px-8">
    <!-- Header -->
    <div class="mb-20 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <span class="text-xs font-mono text-primary/70 uppercase tracking-widest mb-4 block">Technologies</span>
        <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          Tools we ship with
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-text-muted lg:text-right">
        We choose technologies based on your product's needs — never the other way around.
      </p>
    </div>

    <!-- Tech grid -->
    <div class="grid grid-cols-2 gap-0 border border-white/[0.06] sm:grid-cols-3 lg:grid-cols-6 tech-grid">
      {categories.map((cat, i) => (
        <div class="group relative p-6 border-r border-b border-white/[0.06] last:border-r-0 transition-all duration-400 hover:bg-white/[0.02]" data-index={i}>
          <!-- Glow -->
          <div class="absolute inset-0 bg-primary/[0.02] opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>

          <div class="relative">
            <h3 class="text-[11px] font-mono uppercase tracking-wider text-primary/60 mb-4 transition-colors duration-300 group-hover:text-primary">{cat.name}</h3>
            <div class="flex flex-col gap-2">
              {cat.tools.map((tool) => (
                <span class="text-xs text-text-muted transition-colors duration-300 group-hover:text-text-secondary">{tool}</span>
              ))}
            </div>
          </div>

          <!-- Bottom accent line on hover -->
          <div class="absolute bottom-0 left-0 h-[1px] w-0 bg-gradient-to-r from-primary to-transparent transition-all duration-500 group-hover:w-full"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-grid > div:nth-child(n+4) {
    border-bottom: none;
  }

  @media (max-width: 1023px) {
    .tech-grid > div:nth-child(n+4) {
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .tech-grid > div:nth-child(n+5) {
      border-bottom: none;
    }
  }

  @media (max-width: 639px) {
    .tech-grid > div:nth-child(n+5) {
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .tech-grid > div:nth-child(n+6) {
      border-bottom: none;
    }
    .tech-grid > div:nth-child(even) {
      border-right: none;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const items = entry.target.querySelectorAll('[data-index]');
          items.forEach((item, i) => {
            setTimeout(() => {
              (item as HTMLElement).style.opacity = '1';
              (item as HTMLElement).style.transform = 'translateY(0)';
            }, i * 80);
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.2 }
  );

  const grid = document.querySelector('.tech-grid');
  if (grid) {
    grid.querySelectorAll('[data-index]').forEach((item) => {
      (item as HTMLElement).style.opacity = '0';
      (item as HTMLElement).style.transform = 'translateY(16px)';
      (item as HTMLElement).style.transition = 'opacity 0.5s ease, transform 0.5s ease';
    });
    observer.observe(grid);
  }
</script>
