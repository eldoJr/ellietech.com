---
const steps = [
  'Once we receive and process your request, we will get back to you to detail your project needs and sign an NDA to ensure confidentiality.',
  'After examining your wants, needs, and expectations, our team will devise a project proposal with the scope of work, team size, time, and cost estimates.',
  'We will arrange a meeting with you to discuss the offer and nail down the details.',
  'Finally, we will sign a contract and start working on your project right away.',
];

const budgetOptions = ['< $10K', '$10K – $50K', '$50K – $100K', '$100K – $250K', '$250K+'];
---

<section id="contact" class="px-6 py-32">
  <div class="mx-auto max-w-[1440px] px-0 md:px-8">
    <!-- Header -->
    <div class="mb-16">
      <span class="text-xs font-mono text-primary/70 uppercase tracking-widest mb-4 block">Contact</span>
      <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl mb-4">
        Let's discuss your project
      </h2>
      <p class="text-sm text-text-muted leading-relaxed max-w-lg">
        Book a call or fill out the form below and we will get back to you once we have processed your request.
      </p>
    </div>

    <div class="grid gap-16 lg:grid-cols-[1.2fr_0.8fr]">
      <!-- Left: Form -->
      <div>
        <form class="space-y-6">
          <!-- Row: Name + Company -->
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="c-name" class="block text-xs font-medium text-text-secondary mb-2">Name <span class="text-primary">*</span></label>
              <input
                type="text"
                id="c-name"
                name="name"
                required
                class="w-full bg-transparent border-b border-white/[0.1] py-2.5 text-sm text-text-primary placeholder:text-text-muted/40 outline-none transition-colors focus:border-primary"
                placeholder="Your full name"
              />
            </div>
            <div>
              <label for="c-company" class="block text-xs font-medium text-text-secondary mb-2">Company <span class="text-primary">*</span></label>
              <input
                type="text"
                id="c-company"
                name="company"
                required
                class="w-full bg-transparent border-b border-white/[0.1] py-2.5 text-sm text-text-primary placeholder:text-text-muted/40 outline-none transition-colors focus:border-primary"
                placeholder="Company name"
              />
            </div>
          </div>

          <!-- Row: Email + Phone -->
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="c-email" class="block text-xs font-medium text-text-secondary mb-2">Corporate email <span class="text-primary">*</span></label>
              <input
                type="email"
                id="c-email"
                name="email"
                required
                class="w-full bg-transparent border-b border-white/[0.1] py-2.5 text-sm text-text-primary placeholder:text-text-muted/40 outline-none transition-colors focus:border-primary"
                placeholder="you@company.com"
              />
            </div>
            <div>
              <label for="c-phone" class="block text-xs font-medium text-text-secondary mb-2">Phone <span class="text-primary">*</span></label>
              <input
                type="tel"
                id="c-phone"
                name="phone"
                required
                class="w-full bg-transparent border-b border-white/[0.1] py-2.5 text-sm text-text-primary placeholder:text-text-muted/40 outline-none transition-colors focus:border-primary"
                placeholder="+1 (555) 000-0000"
              />
            </div>
          </div>

          <!-- Budget -->
          <div>
            <label class="block text-xs font-medium text-text-secondary mb-3">Project budget</label>
            <div class="flex flex-wrap gap-2">
              {budgetOptions.map((opt, i) => (
                <label class="cursor-pointer">
                  <input type="radio" name="budget" value={opt} class="peer sr-only" checked={i === 1} />
                  <span class="inline-block px-3 py-1.5 text-xs text-text-muted border border-white/[0.08] transition-all duration-200 peer-checked:border-primary/40 peer-checked:text-primary peer-checked:bg-primary/5 hover:border-white/[0.15] rounded-sm">
                    {opt}
                  </span>
                </label>
              ))}
            </div>
          </div>

          <!-- Message -->
          <div>
            <label for="c-message" class="block text-xs font-medium text-text-secondary mb-2">Describe your needs in detail <span class="text-primary">*</span></label>
            <textarea
              id="c-message"
              name="message"
              rows="4"
              required
              class="w-full bg-transparent border-b border-white/[0.1] py-2.5 text-sm text-text-primary placeholder:text-text-muted/40 outline-none transition-colors focus:border-primary resize-none"
              placeholder="Tell us about your project goals, timeline, and any specific requirements..."
            ></textarea>
          </div>

          <!-- File upload -->
          <div>
            <label class="group flex items-center gap-3 cursor-pointer py-2">
              <div class="flex h-8 w-8 items-center justify-center border border-white/[0.08] text-text-muted transition-colors duration-200 group-hover:border-primary/30 group-hover:text-primary rounded-sm">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                </svg>
              </div>
              <span class="text-xs text-text-muted transition-colors duration-200 group-hover:text-text-secondary">Attach documents</span>
              <input type="file" name="attachment" class="sr-only" multiple />
            </label>
          </div>

          <!-- Consent -->
          <p class="text-[10px] text-text-muted/50 leading-relaxed max-w-md">
            By clicking Send, you consent to EllieTech processing your personal data per our Privacy Policy to provide you with relevant information. By submitting your phone number, you agree that we may contact you via voice calls, SMS, and messaging apps.
          </p>

          <!-- Submit -->
          <button
            type="submit"
            class="group inline-flex items-center gap-2 bg-primary px-8 py-3.5 text-sm font-medium text-white transition-all duration-200 hover:bg-primary-light hover:shadow-xl hover:shadow-primary/20 rounded-sm cursor-pointer"
          >
            Send request
            <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </button>
        </form>
      </div>

      <!-- Right: What happens next -->
      <div class="lg:pl-8 lg:border-l lg:border-white/[0.06]">
        <h3 class="text-base font-semibold text-text-primary mb-8">What happens next?</h3>
        <div class="space-y-6">
          {steps.map((step, i) => (
            <div class="flex gap-4">
              <span class="flex h-7 w-7 items-center justify-center border border-white/[0.08] text-[10px] font-mono text-primary flex-shrink-0 mt-0.5">
                {i + 1}
              </span>
              <p class="text-xs text-text-muted leading-relaxed">{step}</p>
            </div>
          ))}
        </div>

        <!-- Quick contact -->
        <div class="mt-12 pt-8 border-t border-white/[0.06]">
          <p class="text-xs text-text-muted mb-4">Prefer a direct conversation?</p>
          <div class="space-y-3">
            <a href="mailto:hello@ellietech.com" class="flex items-center gap-3 text-sm text-text-secondary transition-colors duration-200 hover:text-primary">
              <svg class="h-4 w-4 text-primary/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              hello@ellietech.com
            </a>
            <a href="tel:+1234567890" class="flex items-center gap-3 text-sm text-text-secondary transition-colors duration-200 hover:text-primary">
              <svg class="h-4 w-4 text-primary/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +1 (555) 000-0000
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
