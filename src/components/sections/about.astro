---
import Badge from '../ui/badge.astro';

const stats = [
  { value: '50+', label: 'Projects Delivered' },
  { value: '99.9%', label: 'Uptime SLA' },
  { value: '<200ms', label: 'Avg Response Time' },
  { value: '24/7', label: 'Support & Monitoring' },
];
---

<section id="about" class="px-6 py-32">
  <div class="mx-auto max-w-7xl">
    <div class="grid items-center gap-16 lg:grid-cols-2">
      <div>
        <Badge variant="accent" class="mb-4">About Us</Badge>
        <h2 class="mb-6 text-3xl font-bold tracking-tight sm:text-4xl">
          A studio built for<br />the modern era
        </h2>
        <div class="space-y-4 text-text-secondary">
          <p class="leading-relaxed">
            EllieTech is a modern engineering studio that partners with startups and enterprises to build world-class digital products. We combine deep technical expertise with product thinking to deliver solutions that matter.
          </p>
          <p class="leading-relaxed">
            Our team brings experience from leading tech companies, with a shared passion for clean architecture, performance optimization, and user-centric design. We don't just write code — we engineer systems that scale.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        {
          stats.map((stat) => (
            <div class="rounded-2xl border border-border/50 bg-surface-light p-6 text-center">
              <div class="mb-1 text-2xl font-bold text-primary sm:text-3xl">{stat.value}</div>
              <div class="text-sm text-text-muted">{stat.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
