---
import { getCollection } from 'astro:content';

const projects = (await getCollection('work'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="work" class="px-6 py-32">
  <div class="mx-auto max-w-[1440px] px-0 md:px-8">
    <!-- Header -->
    <div class="mb-20">
      <span class="text-xs font-mono text-primary/70 uppercase tracking-widest mb-4 block">Portfolio</span>
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          Products we've<br />engineered
        </h2>
        <p class="max-w-md text-sm leading-relaxed text-text-muted">
          A selection of systems built for ambitious teams — from early-stage startups to enterprise scale.
        </p>
      </div>
    </div>

    <!-- Projects — individual cards -->
    <div class="work-list">
      {projects.map((project, i) => {
        const num = String(i + 1).padStart(2, '0');
        const isReversed = i % 2 !== 0;
        return (
          <article
            class="group relative border-t border-white/[0.06] py-12 lg:py-16 work-item"
            data-index={i}
          >
            <div class:list={['flex flex-col gap-8 lg:gap-12', isReversed ? 'lg:flex-row-reverse' : 'lg:flex-row']}>

              {/* Image */}
              <div class="relative w-full lg:w-[55%] flex-shrink-0">
                <div class="relative h-56 sm:h-72 lg:h-80 overflow-hidden bg-surface-elevated">
                  {project.data.image ? (
                    <img src={project.data.image} alt={project.data.title} class="w-full h-full object-cover opacity-40 transition-all duration-700 group-hover:opacity-60 group-hover:scale-[1.02]" />
                  ) : (
                    <div class="flex items-center justify-center w-full h-full bg-gradient-to-br from-surface-elevated to-surface">
                      <span class="text-6xl font-bold text-white/[0.02]">{num}</span>
                    </div>
                  )}
                  {/* Number overlay */}
                  <div class="absolute top-5 left-5 flex items-center gap-3">
                    <span class="flex items-center justify-center h-9 w-9 border border-white/[0.1] bg-surface/70 backdrop-blur-sm text-[11px] font-mono text-primary">
                      {num}
                    </span>
                    <span class="text-[10px] font-mono text-text-muted/60 uppercase tracking-wider">{project.data.category}</span>
                  </div>
                  {/* Action icons overlay */}
                  <div class="absolute bottom-5 right-5 flex items-center gap-2 opacity-0 translate-y-2 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0">
                    {project.data.github && (
                      <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center h-8 w-8 bg-surface/80 backdrop-blur-sm border border-white/[0.08] text-text-muted transition-colors duration-200 hover:text-text-primary rounded-sm" aria-label="GitHub source">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22" />
                        </svg>
                      </a>
                    )}
                    {project.data.live && (
                      <a href={project.data.live} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center h-8 w-8 bg-surface/80 backdrop-blur-sm border border-white/[0.08] text-text-muted transition-colors duration-200 hover:text-primary rounded-sm" aria-label="Live project">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
                        </svg>
                      </a>
                    )}
                  </div>
                </div>
              </div>

              {/* Content */}
              <div class="flex flex-col justify-center lg:w-[45%]">
                {project.data.year && (
                  <span class="text-[10px] font-mono text-text-muted/30 mb-3">{project.data.year}</span>
                )}

                <h3 class="text-2xl font-bold text-text-primary mb-4 transition-colors duration-300 group-hover:text-primary lg:text-3xl">
                  {project.data.title}
                </h3>

                <p class="text-sm text-text-secondary leading-relaxed mb-8 max-w-md">
                  {project.data.description}
                </p>

                {/* Tech */}
                <div class="flex flex-wrap gap-2">
                  {project.data.tech.map((t) => (
                    <span class="px-2.5 py-1 text-[10px] text-text-muted border border-white/[0.06] rounded-sm transition-colors duration-300 group-hover:border-white/[0.12] group-hover:text-text-secondary">
                      {t}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </article>
        );
      })}
      {/* Final border */}
      <div class="border-t border-white/[0.06]"></div>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).style.opacity = '1';
          (entry.target as HTMLElement).style.transform = 'translateY(0)';
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('.work-item').forEach((item) => {
    (item as HTMLElement).style.opacity = '0';
    (item as HTMLElement).style.transform = 'translateY(30px)';
    (item as HTMLElement).style.transition = 'opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1)';
    observer.observe(item);
  });
</script>
