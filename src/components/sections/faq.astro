---
const faqs = [
  {
    question: 'What types of projects do you take on?',
    answer: 'We work on full-stack web apps, mobile applications, AI/ML systems, SaaS platforms, and cloud infrastructure. From MVPs for early-stage startups to enterprise-scale systems handling millions of users.',
  },
  {
    question: 'How long does a typical project take?',
    answer: 'MVPs typically take 4-8 weeks. Mid-complexity products range from 3-6 months. Enterprise systems can take 6-12 months. We provide detailed timelines during the discovery phase before any commitment.',
  },
  {
    question: 'Do you work with startups or enterprises?',
    answer: 'Both. We adapt our process to fit your stage — whether you need to move fast for a launch deadline or meet enterprise compliance requirements like HIPAA, PCI DSS, or SOC 2.',
  },
  {
    question: 'What does your pricing look like?',
    answer: 'We offer project-based pricing for defined scopes and monthly retainers for ongoing development. Every engagement starts with a scoped proposal with clear deliverables — no hidden costs, no surprises.',
  },
  {
    question: 'Can you work with our existing team?',
    answer: 'Absolutely. We integrate seamlessly with in-house teams, following your workflows, code standards, and communication tools. We can augment your team or take full ownership of a product stream.',
  },
  {
    question: 'What happens after launch?',
    answer: 'We offer ongoing support packages including monitoring, bug fixes, performance optimization, and feature iteration. Most clients continue working with us post-launch as their product evolves.',
  },
  {
    question: 'How do you handle communication and updates?',
    answer: 'Weekly demos, shared Slack channels, real-time project boards, and a dedicated project lead. You always know what is being built, what is next, and where your budget stands.',
  },
  {
    question: 'Do you sign NDAs?',
    answer: 'Yes. We sign NDAs before any discovery call if needed. Your intellectual property and business information are always protected.',
  },
];
---

<section id="faq" class="px-6 py-32">
  <div class="mx-auto max-w-[1440px] px-0 md:px-8">
    <div class="grid gap-16 lg:grid-cols-[1fr_1.5fr]">
      <!-- Left: sticky header -->
      <div class="lg:sticky lg:top-32 lg:self-start">
        <span class="text-xs font-mono text-primary/70 uppercase tracking-widest mb-4 block">FAQ</span>
        <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl mb-6">
          Common<br />questions
        </h2>
        <p class="text-sm text-text-muted leading-relaxed mb-8 max-w-sm">
          Everything you need to know before starting a project with us. Still have questions?
        </p>
        <a
          href="#contact"
          class="group inline-flex items-center gap-2 text-sm font-medium text-primary transition-colors duration-200 hover:text-primary-light"
        >
          Get in touch
          <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Right: accordion -->
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details
            class="group border-b border-white/[0.06] faq-item"
            data-index={i}
          >
            <summary class="flex cursor-pointer items-center justify-between gap-4 py-6 list-none [&::-webkit-details-marker]:hidden transition-colors duration-200 hover:text-primary">
              <span class="text-sm font-medium text-text-primary group-hover:text-primary transition-colors duration-200 sm:text-base">
                {faq.question}
              </span>
              <span class="flex h-6 w-6 items-center justify-center flex-shrink-0 border border-white/[0.08] text-text-muted transition-all duration-300 group-open:border-primary/30 group-open:text-primary group-open:rotate-45 rounded-sm">
                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
              </span>
            </summary>
            <div class="pb-6 pr-10">
              <p class="text-sm text-text-muted leading-relaxed">{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Accordion — close others on open
  document.querySelectorAll('.faq-list details').forEach((detail) => {
    detail.addEventListener('toggle', () => {
      if ((detail as HTMLDetailsElement).open) {
        document.querySelectorAll('.faq-list details').forEach((other) => {
          if (other !== detail && (other as HTMLDetailsElement).open) {
            (other as HTMLDetailsElement).removeAttribute('open');
          }
        });
      }
    });
  });

  // Scroll animation
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const items = entry.target.querySelectorAll('.faq-item');
          items.forEach((item, i) => {
            setTimeout(() => {
              (item as HTMLElement).style.opacity = '1';
              (item as HTMLElement).style.transform = 'translateY(0)';
            }, i * 60);
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  const list = document.querySelector('.faq-list');
  if (list) {
    list.querySelectorAll('.faq-item').forEach((item) => {
      (item as HTMLElement).style.opacity = '0';
      (item as HTMLElement).style.transform = 'translateY(12px)';
      (item as HTMLElement).style.transition = 'opacity 0.4s ease, transform 0.4s ease';
    });
    observer.observe(list);
  }
</script>
