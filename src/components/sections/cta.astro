---
import Button from '../ui/button.astro';
---

<section class="px-6 py-32">
  <div class="mx-auto max-w-4xl rounded-3xl border border-border/50 bg-gradient-to-br from-surface-light to-surface-elevated p-12 text-center sm:p-16">
    <h2 class="mb-4 text-3xl font-bold tracking-tight sm:text-4xl">
      Let's build your next<br />
      <span class="bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent">big idea</span>
    </h2>
    <p class="mx-auto mb-8 max-w-xl text-text-secondary">
      From concept to launch, we partner with you to create products that users love and businesses rely on.
    </p>
    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <Button variant="primary" size="lg" href="#contact">
        Start a Conversation
      </Button>
      <Button variant="ghost" size="lg" href="mailto:hello@ellietech.com">
        hello@ellietech.com
      </Button>
    </div>
  </div>
</section>
