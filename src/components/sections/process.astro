---
import Badge from '../ui/badge.astro';

const steps = [
  {
    number: '01',
    title: 'Discovery',
    description: 'We dive deep into your vision, users, and constraints to define the right solution.',
  },
  {
    number: '02',
    title: 'Architecture',
    description: 'System design, tech stack selection, and a clear roadmap before writing a single line of code.',
  },
  {
    number: '03',
    title: 'Engineering',
    description: 'Iterative development with weekly demos, clean code, and continuous integration.',
  },
  {
    number: '04',
    title: 'Launch & Scale',
    description: 'Production deployment, monitoring, and ongoing optimization as your product grows.',
  },
];
---

<section id="process" class="px-6 py-32 border-t border-border/50">
  <div class="mx-auto max-w-7xl">
    <div class="mb-16 max-w-2xl">
      <Badge variant="primary" class="mb-4">Our Process</Badge>
      <h2 class="mb-4 text-3xl font-bold tracking-tight sm:text-4xl">
        From idea to production<br />in weeks, not months
      </h2>
      <p class="text-lg text-text-secondary">
        A proven methodology that balances speed with quality.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step) => (
          <div class="relative">
            <div class="mb-4 text-4xl font-bold text-primary/20">{step.number}</div>
            <h3 class="mb-2 text-lg font-semibold">{step.title}</h3>
            <p class="text-sm leading-relaxed text-text-secondary">{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
