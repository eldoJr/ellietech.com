---
const steps = [
  {
    number: '01',
    title: 'Discovery & Strategy',
    description: 'We analyze your business goals, users, and technical constraints. The output is a clear product roadmap, architecture blueprint, and scoped timeline — before any code is written.',
    deliverables: ['Product roadmap', 'Technical architecture', 'Timeline & budget'],
    duration: '1–2 weeks',
  },
  {
    number: '02',
    title: 'Design & Prototype',
    description: 'UI/UX design grounded in user research. We deliver interactive prototypes you can test with real users, iterate fast, and validate assumptions before engineering begins.',
    deliverables: ['Wireframes', 'UI design system', 'Interactive prototype'],
    duration: '2–3 weeks',
  },
  {
    number: '03',
    title: 'Engineering & QA',
    description: 'Agile sprints with weekly demos. Clean, tested code with CI/CD from day one. You see progress every week and can steer direction without costly rewrites.',
    deliverables: ['Working software', 'Automated tests', 'CI/CD pipeline'],
    duration: '4–12 weeks',
  },
  {
    number: '04',
    title: 'Launch & Evolve',
    description: 'Production deployment with monitoring, alerting, and performance baselines. Post-launch we provide ongoing support, optimization, and feature iteration.',
    deliverables: ['Production deploy', 'Monitoring setup', 'Ongoing support'],
    duration: 'Ongoing',
  },
];
---

<section id="process" class="px-6 py-32">
  <div class="mx-auto max-w-[1440px] px-0 md:px-8">
    <!-- Header -->
    <div class="mb-20">
      <span class="text-xs font-mono text-primary/70 uppercase tracking-widest mb-4 block">How we work</span>
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          From idea to production<br />in weeks, not months
        </h2>
        <p class="max-w-md text-sm leading-relaxed text-text-muted">
          A battle-tested methodology that balances speed with quality. No surprises, no scope creep.
        </p>
      </div>
    </div>

    <!-- Process steps -->
    <div class="relative process-steps">
      <!-- Vertical line -->
      <div class="absolute left-[19px] top-0 bottom-0 w-[1px] bg-white/[0.06] hidden lg:block"></div>

      <div class="space-y-0">
        {steps.map((step, i) => (
          <div
            class="group relative grid gap-6 border-b border-white/[0.06] py-10 lg:grid-cols-[60px_1fr_200px] lg:items-start lg:gap-10 process-item"
            data-index={i}
          >
            {/* Number */}
            <div class="relative flex items-center gap-4 lg:flex-col lg:items-center lg:gap-0">
              <div class="relative z-10 flex h-10 w-10 items-center justify-center border border-white/[0.08] bg-surface text-xs font-mono text-primary transition-all duration-500 group-hover:border-primary/40 group-hover:bg-primary/5 group-hover:shadow-lg group-hover:shadow-primary/10">
                {step.number}
              </div>
              <h3 class="text-lg font-semibold lg:hidden">{step.title}</h3>
            </div>

            {/* Content */}
            <div>
              <h3 class="hidden text-xl font-semibold mb-3 transition-colors duration-300 group-hover:text-primary lg:block">
                {step.title}
              </h3>
              <p class="text-sm text-text-secondary leading-relaxed mb-5 max-w-2xl">
                {step.description}
              </p>
              <div class="flex flex-wrap gap-3">
                {step.deliverables.map((d) => (
                  <span class="flex items-center gap-2 text-xs text-text-muted">
                    <span class="h-1 w-1 bg-primary/50 rounded-full flex-shrink-0"></span>
                    {d}
                  </span>
                ))}
              </div>
            </div>

            {/* Duration */}
            <div class="hidden lg:flex lg:justify-end">
              <span class="text-[10px] font-mono text-text-muted/50 uppercase tracking-wider border border-white/[0.06] px-3 py-1.5 transition-colors duration-300 group-hover:border-primary/20 group-hover:text-primary/60">
                {step.duration}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const items = entry.target.querySelectorAll('.process-item');
          items.forEach((item, i) => {
            setTimeout(() => {
              (item as HTMLElement).style.opacity = '1';
              (item as HTMLElement).style.transform = 'translateY(0)';
            }, i * 120);
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  const steps = document.querySelector('.process-steps');
  if (steps) {
    steps.querySelectorAll('.process-item').forEach((item) => {
      (item as HTMLElement).style.opacity = '0';
      (item as HTMLElement).style.transform = 'translateY(16px)';
      (item as HTMLElement).style.transition = 'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    observer.observe(steps);
  }
</script>
