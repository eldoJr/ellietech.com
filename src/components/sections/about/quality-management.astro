---
const standards = [
  {
    title: 'ISO 9001:2015',
    description: 'Quality management systems certification ensuring consistent delivery and continuous improvement.',
    badge: 'ISO 9001',
  },
  {
    title: 'ISO 27001:2013',
    description: 'Information security management system certification protecting client data and intellectual property.',
    badge: 'ISO 27001',
  },
  {
    title: 'CMMI Level 3',
    description: 'Capability Maturity Model Integration for process optimization and predictable project outcomes.',
    badge: 'CMMI L3',
  },
];

const practices = [
  'Code reviews on every pull request',
  'Automated testing (unit, integration, E2E)',
  'Continuous integration and deployment',
  'Security scanning and vulnerability assessment',
  'Performance monitoring and optimization',
  'Documentation and knowledge transfer',
];
---

<section id="quality-management" class="px-6 py-32">
  <div class="mx-auto max-w-[1440px] px-0 md:px-8">
    <!-- Header -->
    <div class="mb-20 grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-start">
      <div>
        <span class="text-xs font-mono text-primary/70 uppercase tracking-widest mb-4 block">Quality management</span>
        <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          Built on standards,<br />refined by experience
        </h2>
      </div>
      <div class="lg:pt-10">
        <p class="text-sm leading-relaxed text-text-secondary max-w-md">
          Quality is not a phase — it is embedded in every line of code, every design decision, and every client interaction.
        </p>
      </div>
    </div>

    <!-- Standards -->
    <div class="grid gap-8 mb-16 lg:grid-cols-3">
      {standards.map((standard, i) => (
        <div
          class="group relative border border-border/30 p-8 transition-all duration-300 hover:border-primary/30 standard-card"
          data-index={i}
        >
          <div class="flex items-start justify-between mb-4">
            <span class="text-xs font-mono text-primary border border-primary/30 px-3 py-1.5 bg-primary/5">
              {standard.badge}
            </span>
          </div>
          <h3 class="text-lg font-semibold mb-3 transition-colors duration-300 group-hover:text-primary">
            {standard.title}
          </h3>
          <p class="text-xs text-text-muted leading-relaxed">
            {standard.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Practices -->
    <div class="border-t border-border/30 pt-12">
      <h3 class="text-xl font-semibold mb-8">Quality assurance practices</h3>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {practices.map((practice, i) => (
          <div
            class="flex items-start gap-3 practice-item"
            data-index={i}
          >
            <svg class="h-5 w-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-sm text-text-secondary">{practice}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const cards = entry.target.querySelectorAll('.standard-card');
          cards.forEach((card, i) => {
            setTimeout(() => {
              (card as HTMLElement).style.opacity = '1';
              (card as HTMLElement).style.transform = 'translateY(0)';
            }, i * 100);
          });
          
          const practices = entry.target.querySelectorAll('.practice-item');
          practices.forEach((item, i) => {
            setTimeout(() => {
              (item as HTMLElement).style.opacity = '1';
              (item as HTMLElement).style.transform = 'translateX(0)';
            }, 300 + i * 60);
          });
          
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  const section = document.getElementById('quality-management');
  if (section) {
    section.querySelectorAll('.standard-card').forEach((card) => {
      (card as HTMLElement).style.opacity = '0';
      (card as HTMLElement).style.transform = 'translateY(20px)';
      (card as HTMLElement).style.transition = 'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    
    section.querySelectorAll('.practice-item').forEach((item) => {
      (item as HTMLElement).style.opacity = '0';
      (item as HTMLElement).style.transform = 'translateX(-10px)';
      (item as HTMLElement).style.transition = 'opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    
    observer.observe(section);
  }
</script>
