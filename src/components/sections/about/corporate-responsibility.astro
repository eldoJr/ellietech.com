---
const initiatives = [
  {
    icon: 'leaf',
    title: 'Carbon-neutral operations',
    description: 'We offset 100% of our carbon footprint through verified renewable energy credits and reforestation projects.',
    metrics: ['100% renewable energy', 'Carbon neutral since 2020'],
  },
  {
    icon: 'graduation-cap',
    title: 'Education & mentorship',
    description: 'Free coding bootcamps, university partnerships, and mentorship programs to build the next generation of engineers.',
    metrics: ['500+ students trained', '50+ mentors active'],
  },
  {
    icon: 'heart',
    title: 'Community giving',
    description: 'Pro-bono work for nonprofits, open-source contributions, and 1% of revenue donated to tech education.',
    metrics: ['20+ nonprofits supported', '1% revenue donated'],
  },
  {
    icon: 'users-round',
    title: 'Diversity & inclusion',
    description: 'Equal pay audits, blind hiring processes, and partnerships with underrepresented communities in tech.',
    metrics: ['40% women in leadership', 'Pay equity certified'],
  },
];
---

<section id="corporate-responsibility" class="px-6 py-32 bg-surface-elevated dark:bg-surface">
  <div class="mx-auto max-w-[1440px] px-0 md:px-8">
    <!-- Header -->
    <div class="mb-20">
      <span class="text-xs font-mono text-primary/70 uppercase tracking-widest mb-4 block">Corporate responsibility</span>
      <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-start">
        <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          Building technology<br />that builds communities
        </h2>
        <div class="lg:pt-4">
          <p class="text-sm leading-relaxed text-text-secondary max-w-md">
            Profit and purpose are not mutually exclusive. We measure success by the positive impact we create — for clients, employees, and society.
          </p>
        </div>
      </div>
    </div>

    <!-- Initiatives -->
    <div class="grid gap-8 lg:grid-cols-2">
      {initiatives.map((initiative, i) => (
        <div
          class="group relative border border-border/30 p-8 transition-all duration-300 hover:border-primary/30 hover:bg-surface/50 initiative-card"
          data-index={i}
        >
          <div class="mb-4 text-primary">
            <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              {initiative.icon === 'leaf' && (
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
              )}
              {initiative.icon === 'graduation-cap' && (
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z M12 14l-9-5v7.5A2.5 2.5 0 005.5 19h13a2.5 2.5 0 002.5-2.5V9l-9 5z"/>
              )}
              {initiative.icon === 'heart' && (
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              )}
              {initiative.icon === 'users-round' && (
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
              )}
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3 transition-colors duration-300 group-hover:text-primary">
            {initiative.title}
          </h3>
          <p class="text-sm text-text-secondary leading-relaxed mb-6">
            {initiative.description}
          </p>
          
          <!-- Metrics -->
          <div class="flex flex-wrap gap-3">
            {initiative.metrics.map((metric) => (
              <span class="text-[10px] font-mono text-primary/70 border border-primary/20 px-3 py-1.5 bg-primary/5">
                {metric}
              </span>
            ))}
          </div>
          
          <!-- Hover accent -->
          <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-gradient-to-r from-primary to-transparent transition-all duration-500 group-hover:w-full"></div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-16 border-t border-border/30 pt-12">
      <div class="flex flex-col gap-6 items-start lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h3 class="text-xl font-semibold mb-2">Want to learn more about our impact?</h3>
          <p class="text-sm text-text-muted">Download our annual sustainability report.</p>
        </div>
        <a
          href="#"
          class="group inline-flex items-center gap-2 border border-primary/30 px-6 py-3 text-sm font-medium text-primary transition-all duration-300 hover:bg-primary hover:text-white"
        >
          Download report
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const cards = entry.target.querySelectorAll('.initiative-card');
          cards.forEach((card, i) => {
            setTimeout(() => {
              (card as HTMLElement).style.opacity = '1';
              (card as HTMLElement).style.transform = 'translateY(0)';
            }, i * 100);
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  const section = document.getElementById('corporate-responsibility');
  if (section) {
    section.querySelectorAll('.initiative-card').forEach((card) => {
      (card as HTMLElement).style.opacity = '0';
      (card as HTMLElement).style.transform = 'translateY(20px)';
      (card as HTMLElement).style.transition = 'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    observer.observe(section);
  }
</script>
