---
const upcomingEvents = [
  {
    type: 'Conference',
    title: 'AWS re:Invent 2024',
    date: 'Dec 2-6, 2024',
    location: 'Las Vegas, NV',
    description: 'Join us at booth #2047 to discuss cloud architecture and serverless solutions.',
    status: 'Speaking',
  },
  {
    type: 'Webinar',
    title: 'Building Scalable AI Systems',
    date: 'Nov 15, 2024',
    location: 'Online',
    description: 'Free webinar on architecting ML pipelines that scale from prototype to production.',
    status: 'Free',
  },
  {
    type: 'Workshop',
    title: 'Kubernetes Best Practices',
    date: 'Nov 22, 2024',
    location: 'San Francisco, CA',
    description: 'Hands-on workshop covering K8s security, monitoring, and cost optimization.',
    status: 'Limited seats',
  },
];

const pastEvents = [
  {
    title: 'Google Cloud Next 2024',
    date: 'Apr 2024',
    highlight: 'Presented on multi-cloud strategies',
  },
  {
    title: 'KubeCon + CloudNativeCon',
    date: 'Mar 2024',
    highlight: 'Sponsored booth and networking',
  },
  {
    title: 'React Summit 2024',
    date: 'Feb 2024',
    highlight: 'Workshop on React Server Components',
  },
  {
    title: 'DevOps World',
    date: 'Jan 2024',
    highlight: 'Panel discussion on CI/CD automation',
  },
];
---

<section id="events" class="px-6 py-32 bg-surface-elevated dark:bg-surface">
  <div class="mx-auto max-w-[1440px] px-0 md:px-8">
    <!-- Header -->
    <div class="mb-20">
      <span class="text-xs font-mono text-primary/70 uppercase tracking-widest mb-4 block">Events</span>
      <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-start">
        <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          Meet us at<br />industry events
        </h2>
        <div class="lg:pt-4">
          <p class="text-sm leading-relaxed text-text-secondary max-w-md">
            We actively participate in conferences, host webinars, and organize community meetups. Come say hi or join us online.
          </p>
        </div>
      </div>
    </div>

    <!-- Upcoming events -->
    <div class="mb-16">
      <h3 class="text-xl font-semibold mb-8">Upcoming events</h3>
      <div class="grid gap-6 lg:grid-cols-3">
        {upcomingEvents.map((event, i) => (
          <div
            class="group relative border border-border/30 p-6 transition-all duration-300 hover:border-primary/30 hover:bg-surface/50 event-card"
            data-index={i}
          >
            <div class="flex items-start justify-between mb-4">
              <span class="text-[10px] font-mono text-text-muted uppercase tracking-wider">
                {event.type}
              </span>
              <span class="text-[10px] font-mono text-primary border border-primary/30 px-2 py-1 bg-primary/5">
                {event.status}
              </span>
            </div>
            
            <h4 class="text-lg font-semibold mb-2 transition-colors duration-300 group-hover:text-primary">
              {event.title}
            </h4>
            
            <div class="flex items-center gap-4 text-xs text-text-muted mb-3">
              <span class="flex items-center gap-1.5">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                {event.date}
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                {event.location}
              </span>
            </div>
            
            <p class="text-xs text-text-muted leading-relaxed mb-4">
              {event.description}
            </p>
            
            <a
              href="#"
              class="inline-flex items-center gap-2 text-xs text-primary transition-colors hover:text-primary-light"
            >
              Learn more
              <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            
            <!-- Hover accent -->
            <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-gradient-to-r from-primary to-transparent transition-all duration-500 group-hover:w-full"></div>
          </div>
        ))}
      </div>
    </div>

    <!-- Past events -->
    <div class="border-t border-border/30 pt-12">
      <h3 class="text-xl font-semibold mb-8">Past events</h3>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {pastEvents.map((event, i) => (
          <div
            class="border-l-2 border-primary/30 pl-4 py-2 past-event"
            data-index={i}
          >
            <p class="text-xs text-text-muted mb-1">{event.date}</p>
            <h4 class="text-sm font-semibold mb-1">{event.title}</h4>
            <p class="text-xs text-text-muted">{event.highlight}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Newsletter CTA -->
    <div class="mt-16 border-t border-border/30 pt-12">
      <div class="max-w-2xl mx-auto text-center">
        <h3 class="text-xl font-semibold mb-3">Stay updated on our events</h3>
        <p class="text-sm text-text-muted mb-6">
          Subscribe to our newsletter for event announcements, webinar invites, and exclusive content.
        </p>
        <form class="flex gap-3 max-w-md mx-auto">
          <input
            type="email"
            placeholder="Enter your email"
            class="flex-1 bg-transparent border border-border/30 px-4 py-2.5 text-sm text-text-primary placeholder:text-text-muted focus:border-primary focus:outline-none transition-colors"
          />
          <button
            type="submit"
            class="bg-primary px-6 py-2.5 text-sm font-medium text-white transition-all duration-300 hover:bg-primary-light hover:shadow-lg hover:shadow-primary/20"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const cards = entry.target.querySelectorAll('.event-card');
          cards.forEach((card, i) => {
            setTimeout(() => {
              (card as HTMLElement).style.opacity = '1';
              (card as HTMLElement).style.transform = 'translateY(0)';
            }, i * 100);
          });
          
          const pastEvents = entry.target.querySelectorAll('.past-event');
          pastEvents.forEach((event, i) => {
            setTimeout(() => {
              (event as HTMLElement).style.opacity = '1';
              (event as HTMLElement).style.transform = 'translateX(0)';
            }, 300 + i * 60);
          });
          
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  const section = document.getElementById('events');
  if (section) {
    section.querySelectorAll('.event-card').forEach((card) => {
      (card as HTMLElement).style.opacity = '0';
      (card as HTMLElement).style.transform = 'translateY(20px)';
      (card as HTMLElement).style.transition = 'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    
    section.querySelectorAll('.past-event').forEach((event) => {
      (event as HTMLElement).style.opacity = '0';
      (event as HTMLElement).style.transform = 'translateX(-10px)';
      (event as HTMLElement).style.transition = 'opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    
    observer.observe(section);
  }
</script>
