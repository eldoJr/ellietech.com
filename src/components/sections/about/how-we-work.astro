---
const values = [
  {
    icon: 'target',
    title: 'Product-focused engineering',
    description: 'We build products, not projects. Every line of code serves a clear business goal and user need.',
  },
  {
    icon: 'zap',
    title: 'Ship fast, iterate faster',
    description: 'MVP in weeks, not months. Continuous deployment, rapid feedback loops, and data-driven iterations.',
  },
  {
    icon: 'shield',
    title: 'Security by design',
    description: 'Security is not an afterthought. We build with encryption, authentication, and best practices from day one.',
  },
  {
    icon: 'bar-chart',
    title: 'Metrics-driven development',
    description: 'Real-time analytics, performance monitoring, and user behavior tracking guide every decision.',
  },
  {
    icon: 'users',
    title: 'Radical transparency',
    description: 'Open roadmaps, shared repositories, live demos. You see what we build as we build it.',
  },
  {
    icon: 'trending-up',
    title: 'Built to scale',
    description: 'Architecture decisions that support 10x growth without rewrites or migrations.',
  },
];
---

<section id="how-we-work" class="px-6 py-32 bg-surface-elevated dark:bg-surface">
  <div class="mx-auto max-w-[1440px] px-0 md:px-8">
    <!-- Header -->
    <div class="mb-20">
      <span class="text-xs font-mono text-primary/70 uppercase tracking-widest mb-4 block">How we work</span>
      <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-start">
        <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          Our approach to<br />software development
        </h2>
        <div class="lg:pt-4">
          <p class="text-sm leading-relaxed text-text-secondary max-w-md">
            We're a lean, fast-moving team that values speed, quality, and modern engineering practices over bureaucracy and process overhead.
          </p>
        </div>
      </div>
    </div>

    <!-- Values grid -->
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {values.map((value, i) => (
        <div
          class="group relative border border-border/30 p-8 transition-all duration-300 hover:border-primary/30 hover:bg-surface/50 value-card"
          data-index={i}
        >
          <div class="mb-4 text-primary">
            <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              {value.icon === 'target' && (
                <><circle cx="12" cy="12" r="10" stroke-width="2"/><circle cx="12" cy="12" r="6" stroke-width="2"/><circle cx="12" cy="12" r="2" stroke-width="2"/></>
              )}
              {value.icon === 'zap' && (
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              )}
              {value.icon === 'shield' && (
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              )}
              {value.icon === 'bar-chart' && (
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              )}
              {value.icon === 'users' && (
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
              )}
              {value.icon === 'trending-up' && (
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
              )}
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-3 transition-colors duration-300 group-hover:text-primary">
            {value.title}
          </h3>
          <p class="text-xs text-text-muted leading-relaxed">
            {value.description}
          </p>
          
          <!-- Hover accent -->
          <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-gradient-to-r from-primary to-transparent transition-all duration-500 group-hover:w-full"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const cards = entry.target.querySelectorAll('.value-card');
          cards.forEach((card, i) => {
            setTimeout(() => {
              (card as HTMLElement).style.opacity = '1';
              (card as HTMLElement).style.transform = 'translateY(0)';
            }, i * 80);
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  const section = document.getElementById('how-we-work');
  if (section) {
    section.querySelectorAll('.value-card').forEach((card) => {
      (card as HTMLElement).style.opacity = '0';
      (card as HTMLElement).style.transform = 'translateY(20px)';
      (card as HTMLElement).style.transition = 'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    observer.observe(section);
  }
</script>
