---
const steps = [
  {
    number: '01',
    title: 'Discovery & Strategy',
    description: 'We start by understanding your business, users, and market. Through workshops and research, we define a clear product roadmap aligned with measurable outcomes.',
    details: ['Stakeholder interviews', 'Market & competitor analysis', 'User persona mapping', 'Technical feasibility audit'],
  },
  {
    number: '02',
    title: 'Architecture & Design',
    description: 'Our engineers design scalable system architectures while our designers craft intuitive interfaces — both validated through rapid prototyping and user testing.',
    details: ['System design & data modeling', 'UI/UX wireframes & prototypes', 'Technology stack selection', 'Security & compliance planning'],
  },
  {
    number: '03',
    title: 'Agile Development',
    description: 'We ship working software in 2-week sprints. Continuous integration, automated testing, and daily standups keep quality high and timelines predictable.',
    details: ['Sprint-based delivery', 'CI/CD pipelines', 'Code reviews & pair programming', 'Automated test coverage'],
  },
  {
    number: '04',
    title: 'Launch & Scale',
    description: 'From zero to production with confidence. We handle deployment, monitoring, and performance optimization — then iterate based on real user data.',
    details: ['Cloud infrastructure setup', 'Performance & load testing', 'Analytics & monitoring', 'Post-launch iteration cycles'],
  },
];

---

<section id="how-we-work" class="px-6 py-32 bg-surface-elevated dark:bg-surface">
  <div class="mx-auto max-w-[1440px] md:px-8">

    <!-- Section header -->
    <div class="mb-24">
      <span class="text-xs font-mono text-primary/70 uppercase tracking-widest mb-4 block">Our Process</span>
      <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-end">
        <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          How we turn ideas into<br />production-ready software
        </h2>
        <p class="text-sm leading-relaxed text-text-secondary max-w-lg lg:pb-1">
          A proven methodology refined across 50+ projects. We combine lean startup principles with enterprise-grade engineering to deliver software that ships fast and scales reliably.
        </p>
      </div>
    </div>

    <!-- Process steps -->
    <div class="grid gap-0 lg:grid-cols-4 mb-32 relative">
      <!-- Connecting line (desktop) -->
      <div class="hidden lg:block absolute top-12 left-[12.5%] right-[12.5%] h-px bg-gradient-to-r from-primary/40 via-border/50 to-primary/40"></div>

      {steps.map((step, i) => (
        <div class="relative process-step" data-index={i}>
          <!-- Step number -->
          <div class="relative z-10 flex items-center gap-4 lg:flex-col lg:items-start mb-6">
            <div class="flex h-10 w-10 items-center justify-center border border-primary/30 bg-primary/5 text-primary text-xs font-mono font-bold shrink-0">
              {step.number}
            </div>
            <div class="h-px flex-1 bg-border/50 lg:hidden"></div>
          </div>

          <!-- Content -->
          <div class="pl-14 lg:pl-0 lg:pr-8">
            <h3 class="text-lg font-semibold mb-3 text-text-primary">{step.title}</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-5">{step.description}</p>
            <ul class="space-y-2">
              {step.details.map((detail) => (
                <li class="flex items-start gap-2 text-xs text-text-secondary">
                  <span class="mt-1.5 h-1 w-1 rounded-full bg-primary/60 shrink-0"></span>
                  {detail}
                </li>
              ))}
            </ul>
          </div>

          {/* Divider between steps on mobile */}
          {i < steps.length - 1 && (
            <div class="my-10 h-px bg-border/30 lg:hidden"></div>
          )}
        </div>
      ))}
    </div>

    <!-- Engineering principles — Pyramid -->
    <div class="principle-section">
      <div class="mb-16 flex items-center gap-4">
        <h3 class="text-2xl font-bold tracking-tight">Engineering principles</h3>
        <div class="flex-1 h-px bg-border/30 hidden sm:block"></div>
      </div>

      <div class="relative w-full">
        <!-- SVG connecting lines -->
        <svg class="absolute inset-0 w-full h-full pointer-events-none z-0 hidden lg:block" preserveAspectRatio="none">
          <!-- Vertical spine -->
          <line x1="50%" y1="0" x2="50%" y2="100%" stroke="currentColor" stroke-width="1" stroke-dasharray="4 4" class="text-border/40" />
          <!-- Tier 1 to Tier 2 branches -->
          <line x1="50%" y1="22%" x2="25%" y2="38%" stroke="currentColor" stroke-width="1" class="text-primary/20" />
          <line x1="50%" y1="22%" x2="75%" y2="38%" stroke="currentColor" stroke-width="1" class="text-primary/20" />
          <!-- Tier 2 to Tier 3 branches -->
          <line x1="25%" y1="58%" x2="16.5%" y2="72%" stroke="currentColor" stroke-width="1" class="text-primary/20" />
          <line x1="25%" y1="58%" x2="38.5%" y2="72%" stroke="currentColor" stroke-width="1" class="text-primary/20" />
          <line x1="75%" y1="58%" x2="61.5%" y2="72%" stroke="currentColor" stroke-width="1" class="text-primary/20" />
          <line x1="75%" y1="58%" x2="83.5%" y2="72%" stroke="currentColor" stroke-width="1" class="text-primary/20" />
        </svg>

        <!-- Tier 1: Apex -->
        <div class="relative z-10 flex justify-center mb-6 lg:mb-10">
          <div class="principle-card w-full max-w-sm" data-index="0">
            <div class="relative group overflow-hidden border-2 border-primary/30 bg-gradient-to-b from-primary/[0.08] to-transparent p-8 text-center transition-all duration-500 hover:border-primary/60 hover:shadow-[0_0_40px_rgba(255,107,53,0.08)]">
              <!-- Corner accents -->
              <div class="absolute top-0 left-0 w-5 h-5 border-t-2 border-l-2 border-primary/50"></div>
              <div class="absolute top-0 right-0 w-5 h-5 border-t-2 border-r-2 border-primary/50"></div>
              <div class="absolute bottom-0 left-0 w-5 h-5 border-b-2 border-l-2 border-primary/50"></div>
              <div class="absolute bottom-0 right-0 w-5 h-5 border-b-2 border-r-2 border-primary/50"></div>
              <!-- Glow -->
              <div class="absolute inset-0 bg-gradient-to-b from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div class="relative">
                <div class="inline-flex items-center gap-2 mb-3">
                  <div class="h-px w-4 bg-primary/40"></div>
                  <span class="text-[10px] font-mono text-primary uppercase tracking-[0.2em]">Core Principle</span>
                  <div class="h-px w-4 bg-primary/40"></div>
                </div>
                <h4 class="text-base font-bold text-text-primary group-hover:text-primary transition-colors">Product-first mindset</h4>
                <p class="text-xs text-text-muted mt-3 leading-relaxed max-w-xs mx-auto">Every engineering decision serves a business goal. We build products that solve real problems.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Tier 2: Two pillars -->
        <div class="relative z-10 grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6 mb-6 lg:mb-10">
          <div class="principle-card" data-index="1">
            <div class="relative group overflow-hidden border border-border/40 p-7 transition-all duration-500 hover:border-primary/40 hover:bg-surface/80 h-full">
              <!-- Top accent line -->
              <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
              <div class="flex items-start gap-4">
                <div class="shrink-0 w-10 h-10 flex items-center justify-center border border-primary/20 bg-primary/5 text-primary">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                </div>
                <div>
                  <span class="text-[10px] font-mono text-text-muted/50 uppercase tracking-widest">Transparency</span>
                  <h4 class="text-sm font-semibold text-text-primary mt-1 group-hover:text-primary transition-colors">Radical transparency</h4>
                  <p class="text-[11px] text-text-muted mt-2 leading-relaxed">Open roadmaps, shared repositories, live demos. No black boxes, no surprises.</p>
                </div>
              </div>
              <!-- Bottom accent -->
              <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-primary transition-all duration-500 group-hover:w-full"></div>
            </div>
          </div>
          <div class="principle-card" data-index="2">
            <div class="relative group overflow-hidden border border-border/40 p-7 transition-all duration-500 hover:border-primary/40 hover:bg-surface/80 h-full">
              <!-- Top accent line -->
              <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
              <div class="flex items-start gap-4">
                <div class="shrink-0 w-10 h-10 flex items-center justify-center border border-primary/20 bg-primary/5 text-primary">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                </div>
                <div>
                  <span class="text-[10px] font-mono text-text-muted/50 uppercase tracking-widest">Security</span>
                  <h4 class="text-sm font-semibold text-text-primary mt-1 group-hover:text-primary transition-colors">Security by default</h4>
                  <p class="text-[11px] text-text-muted mt-2 leading-relaxed">Encryption, auth, and compliance built into the foundation — never an afterthought.</p>
                </div>
              </div>
              <!-- Bottom accent -->
              <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-primary transition-all duration-500 group-hover:w-full"></div>
            </div>
          </div>
        </div>

        <!-- Tier 3: Four base blocks -->
        <div class="relative z-10 grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-4">
          {[
            { label: 'Scale', title: 'Cloud-native architecture', icon: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z' },
            { label: 'Speed', title: 'CI/CD automation', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
            { label: 'Quality', title: 'Test-driven delivery', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
            { label: 'Growth', title: '10x-ready systems', icon: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6' },
          ].map((item, i) => (
            <div class="principle-card" data-index={i + 3}>
              <div class="relative group overflow-hidden border border-border/30 p-5 text-center transition-all duration-500 hover:border-primary/30 hover:bg-surface/50">
                <div class="mx-auto w-8 h-8 flex items-center justify-center text-text-muted/40 group-hover:text-primary/60 transition-colors mb-3">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/></svg>
                </div>
                <span class="text-[9px] font-mono text-text-muted/40 uppercase tracking-[0.2em] block mb-1">{item.label}</span>
                <h4 class="text-xs font-semibold text-text-primary group-hover:text-primary transition-colors">{item.title}</h4>
                <!-- Bottom accent -->
                <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-gradient-to-r from-primary to-primary/30 transition-all duration-500 group-hover:w-full"></div>
              </div>
            </div>
          ))}
        </div>

        <!-- Bottom label -->
        <div class="mt-8 flex items-center justify-center gap-3">
          <div class="h-px w-12 bg-gradient-to-r from-transparent to-border/40"></div>
          <span class="text-[10px] font-mono text-text-muted/30 uppercase tracking-[0.15em]">Strategy → Execution → Infrastructure</span>
          <div class="h-px w-12 bg-gradient-to-l from-transparent to-border/40"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          // Animate process steps
          const steps = entry.target.querySelectorAll('.process-step');
          steps.forEach((step, i) => {
            setTimeout(() => {
              (step as HTMLElement).style.opacity = '1';
              (step as HTMLElement).style.transform = 'translateY(0)';
            }, i * 120);
          });

          // Animate principle cards
          const cards = entry.target.querySelectorAll('.principle-card');
          cards.forEach((card, i) => {
            setTimeout(() => {
              (card as HTMLElement).style.opacity = '1';
              (card as HTMLElement).style.transform = 'translateY(0)';
            }, (steps.length * 120) + (i * 80));
          });

          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.05 }
  );

  const section = document.getElementById('how-we-work');
  if (section) {
    section.querySelectorAll('.process-step, .principle-card').forEach((el) => {
      (el as HTMLElement).style.opacity = '0';
      (el as HTMLElement).style.transform = 'translateY(24px)';
      (el as HTMLElement).style.transition = 'opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    observer.observe(section);
  }
</script>
