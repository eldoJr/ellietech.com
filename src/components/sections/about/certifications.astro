---
const certifications = [
  {
    category: 'Cloud & Infrastructure',
    certs: [
      'AWS Certified Solutions Architect - Professional',
      'AWS Certified DevOps Engineer - Professional',
      'Azure Solutions Architect Expert',
      'Google Cloud Professional Cloud Architect',
      'Kubernetes Certified Administrator (CKA)',
      'Terraform Associate',
    ],
  },
  {
    category: 'Security & Compliance',
    certs: [
      'Certified Information Systems Security Professional (CISSP)',
      'Certified Ethical Hacker (CEH)',
      'AWS Certified Security - Specialty',
      'HIPAA Compliance Certification',
      'PCI DSS Implementation',
      'SOC 2 Auditor',
    ],
  },
  {
    category: 'Development & Architecture',
    certs: [
      'Professional Scrum Master (PSM)',
      'SAFe Agilist',
      'TOGAF Enterprise Architecture',
      'MongoDB Certified Developer',
      'Oracle Certified Professional',
      'Microsoft Certified: Azure Developer',
    ],
  },
  {
    category: 'Data & AI',
    certs: [
      'Google Cloud Professional Data Engineer',
      'AWS Certified Machine Learning - Specialty',
      'TensorFlow Developer Certificate',
      'Databricks Certified Associate',
      'Snowflake SnowPro Core',
      'Microsoft Certified: Azure AI Engineer',
    ],
  },
];
---

<section id="certifications" class="px-6 py-32">
  <div class="mx-auto max-w-[1440px] px-0 md:px-8">
    <!-- Header -->
    <div class="mb-20">
      <span class="text-xs font-mono text-primary/70 uppercase tracking-widest mb-4 block">Certifications</span>
      <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-start">
        <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          Certified expertise<br />across the stack
        </h2>
        <div class="lg:pt-4">
          <p class="text-sm leading-relaxed text-text-secondary max-w-md">
            Our team holds 200+ industry certifications from AWS, Google, Microsoft, and other leading technology providers.
          </p>
        </div>
      </div>
    </div>

    <!-- Certifications grid -->
    <div class="grid gap-8 lg:grid-cols-2">
      {certifications.map((category, i) => (
        <div
          class="border border-border/30 p-8 cert-category"
          data-index={i}
        >
          <h3 class="text-lg font-semibold mb-6 pb-4 border-b border-border/30">
            {category.category}
          </h3>
          <ul class="space-y-3">
            {category.certs.map((cert) => (
              <li class="flex items-start gap-3">
                <svg class="h-4 w-4 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="text-xs text-text-secondary">{cert}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Stats -->
    <div class="mt-16 grid gap-8 sm:grid-cols-3 border-t border-border/30 pt-12">
      <div class="text-center stat-item" data-index="0">
        <div class="text-4xl font-bold text-primary mb-2">200+</div>
        <p class="text-xs text-text-muted uppercase tracking-wider">Team certifications</p>
      </div>
      <div class="text-center stat-item" data-index="1">
        <div class="text-4xl font-bold text-primary mb-2">15+</div>
        <p class="text-xs text-text-muted uppercase tracking-wider">Technology partners</p>
      </div>
      <div class="text-center stat-item" data-index="2">
        <div class="text-4xl font-bold text-primary mb-2">100%</div>
        <p class="text-xs text-text-muted uppercase tracking-wider">Senior engineers</p>
      </div>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const categories = entry.target.querySelectorAll('.cert-category');
          categories.forEach((cat, i) => {
            setTimeout(() => {
              (cat as HTMLElement).style.opacity = '1';
              (cat as HTMLElement).style.transform = 'translateY(0)';
            }, i * 100);
          });
          
          const stats = entry.target.querySelectorAll('.stat-item');
          stats.forEach((stat, i) => {
            setTimeout(() => {
              (stat as HTMLElement).style.opacity = '1';
              (stat as HTMLElement).style.transform = 'scale(1)';
            }, 400 + i * 100);
          });
          
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  const section = document.getElementById('certifications');
  if (section) {
    section.querySelectorAll('.cert-category').forEach((cat) => {
      (cat as HTMLElement).style.opacity = '0';
      (cat as HTMLElement).style.transform = 'translateY(20px)';
      (cat as HTMLElement).style.transition = 'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    
    section.querySelectorAll('.stat-item').forEach((stat) => {
      (stat as HTMLElement).style.opacity = '0';
      (stat as HTMLElement).style.transform = 'scale(0.9)';
      (stat as HTMLElement).style.transition = 'opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    
    observer.observe(section);
  }
</script>
