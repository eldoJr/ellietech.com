---
const partners = [
  {
    name: 'AWS',
    tier: 'Advanced Consulting Partner',
    description: 'Certified in 15+ AWS services. Built cloud infrastructure for 50+ clients.',
    logo: '/partners/aws.svg',
  },
  {
    name: 'Microsoft Azure',
    tier: 'Gold Partner',
    description: 'Azure-certified architects and developers. Enterprise cloud solutions.',
    logo: '/partners/azure.svg',
  },
  {
    name: 'Google Cloud',
    tier: 'Premier Partner',
    description: 'GCP specialists in AI/ML, data analytics, and Kubernetes.',
    logo: '/partners/gcp.svg',
  },
  {
    name: 'Salesforce',
    tier: 'Consulting Partner',
    description: 'Custom CRM implementations and integrations.',
    logo: '/partners/salesforce.svg',
  },
  {
    name: 'SAP',
    tier: 'Implementation Partner',
    description: 'ERP modernization and S/4HANA migrations.',
    logo: '/partners/sap.svg',
  },
  {
    name: 'MongoDB',
    tier: 'Technology Partner',
    description: 'Database architecture and optimization experts.',
    logo: '/partners/mongodb.svg',
  },
];
---

<section id="tech-partners" class="px-6 py-32 bg-surface-elevated dark:bg-surface">
  <div class="mx-auto max-w-[1440px] px-0 md:px-8">
    <!-- Header -->
    <div class="mb-20">
      <span class="text-xs font-mono text-primary/70 uppercase tracking-widest mb-4 block">Tech partners</span>
      <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-start">
        <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          Partnered with<br />industry leaders
        </h2>
        <div class="lg:pt-4">
          <p class="text-sm leading-relaxed text-text-secondary max-w-md">
            Strategic partnerships with the world's leading technology companies give us early access to new features, dedicated support, and co-marketing opportunities.
          </p>
        </div>
      </div>
    </div>

    <!-- Partners grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {partners.map((partner, i) => (
        <div
          class="group relative border border-border/30 p-8 transition-all duration-300 hover:border-primary/30 hover:bg-surface/50 partner-card"
          data-index={i}
        >
          <!-- Logo placeholder -->
          <div class="h-12 mb-6 flex items-center">
            <div class="text-2xl font-bold text-text-primary/10">{partner.name}</div>
          </div>
          
          <div class="mb-3">
            <span class="text-[10px] font-mono text-primary/70 border border-primary/20 px-2.5 py-1 bg-primary/5">
              {partner.tier}
            </span>
          </div>
          
          <h3 class="text-lg font-semibold mb-2 transition-colors duration-300 group-hover:text-primary">
            {partner.name}
          </h3>
          
          <p class="text-xs text-text-muted leading-relaxed">
            {partner.description}
          </p>
          
          <!-- Hover accent -->
          <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-gradient-to-r from-primary to-transparent transition-all duration-500 group-hover:w-full"></div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-16 border-t border-border/30 pt-12 text-center">
      <p class="text-sm text-text-muted mb-6">
        Interested in partnering with us? Let's explore collaboration opportunities.
      </p>
      <a
        href="#contact"
        class="inline-flex items-center gap-2 border border-primary/30 px-6 py-3 text-sm font-medium text-primary transition-all duration-300 hover:bg-primary hover:text-white"
      >
        Get in touch
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const cards = entry.target.querySelectorAll('.partner-card');
          cards.forEach((card, i) => {
            setTimeout(() => {
              (card as HTMLElement).style.opacity = '1';
              (card as HTMLElement).style.transform = 'translateY(0)';
            }, i * 80);
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  const section = document.getElementById('tech-partners');
  if (section) {
    section.querySelectorAll('.partner-card').forEach((card) => {
      (card as HTMLElement).style.opacity = '0';
      (card as HTMLElement).style.transform = 'translateY(20px)';
      (card as HTMLElement).style.transition = 'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    observer.observe(section);
  }
</script>
