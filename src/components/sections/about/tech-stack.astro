---
const categories = [
  {
    label: 'Frontend',
    techs: ['React', 'Next.js', 'Vue.js', 'TypeScript', 'Tailwind CSS', 'Astro'],
  },
  {
    label: 'Backend',
    techs: ['Node.js', 'Python', 'Java', '.NET', 'PostgreSQL', 'GraphQL'],
  },
  {
    label: 'Mobile',
    techs: ['React Native', 'Flutter', 'Swift', 'Kotlin', 'iOS', 'Android'],
  },
  {
    label: 'Cloud & DevOps',
    techs: ['AWS', 'Azure', 'GCP', 'Docker', 'Kubernetes', 'Terraform'],
  },
  {
    label: 'AI & Data',
    techs: ['OpenAI', 'LangChain', 'TensorFlow', 'PyTorch', 'Pandas', 'Spark'],
  },
  {
    label: 'Tools & Workflow',
    techs: ['GitHub', 'Linear', 'Figma', 'Sentry', 'PostHog', 'Vercel'],
  },
];

const logos = [
  'React', 'Next.js', 'Vue.js', 'Angular', 'TypeScript', 'Node.js',
  'Python', 'Java', 'AWS', 'Docker', 'Kubernetes', 'PostgreSQL',
  'Redis', 'GraphQL', 'Figma', 'TensorFlow', 'Flutter', 'Swift',
  'Terraform', 'Vercel', 'GitHub', 'Linux', 'Rust', 'Go',
];
---

<section id="tech-stack" class="px-6 py-32 bg-surface-elevated dark:bg-surface overflow-hidden">
  <div class="mx-auto max-w-[1440px] md:px-8">

    <!-- Header — centered, different layout from other sections -->
    <div class="text-center max-w-2xl mx-auto mb-24">
      <span class="text-xs font-mono text-primary/70 uppercase tracking-widest mb-4 block">Technology</span>
      <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl mb-6">
        Built with the best
      </h2>
      <p class="text-sm leading-relaxed text-text-secondary">
        We pick technologies for their reliability, performance, and developer experience — not hype. Every tool in our stack earns its place through real-world results.
      </p>
    </div>

    <!-- Horizontal scrollable category tabs -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      {categories.map((cat, i) => (
        <button
          class="stack-tab text-xs font-medium px-4 py-2 border border-border/40 text-text-muted cursor-pointer hover:text-primary hover:border-primary/30"
          data-tab={i}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Tech display — all visible, stacked rows -->
    <div class="space-y-10">
      {categories.map((cat, i) => (
        <div class="stack-row" data-row={i}>
          <div class="flex items-baseline gap-4 mb-4">
            <h3 class="text-xs font-mono text-text-muted/50 uppercase tracking-widest">{cat.label}</h3>
            <div class="flex-1 h-px bg-border/20"></div>
          </div>
          <div class="flex flex-wrap gap-3">
            {cat.techs.map((tech) => (
              <div class="group flex items-center gap-2.5 px-4 py-3 border border-border/30 hover:border-primary/30 cursor-default">
                <div class="w-2 h-2 bg-primary/30 group-hover:bg-primary"></div>
                <span class="text-sm text-text-secondary group-hover:text-text-primary">{tech}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>

  <!-- Logo marquee -->
  <div class="mt-24 relative">
    <div class="absolute left-0 top-0 bottom-0 w-20 bg-gradient-to-r from-surface-elevated dark:from-surface to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-20 bg-gradient-to-l from-surface-elevated dark:from-surface to-transparent z-10 pointer-events-none"></div>

    <div class="marquee mb-3">
      <div class="marquee__track">
        {[...logos, ...logos].map((logo) => (
          <div class="marquee__item"><span>{logo}</span></div>
        ))}
      </div>
    </div>

    <div class="marquee marquee--reverse">
      <div class="marquee__track">
        {[...logos.slice().reverse(), ...logos.slice().reverse()].map((logo) => (
          <div class="marquee__item"><span>{logo}</span></div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes marquee-reverse {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  .marquee {
    overflow: hidden;
    width: 100%;
  }

  .marquee__track {
    display: flex;
    gap: 0.75rem;
    width: max-content;
    animation: marquee 50s linear infinite;
  }

  .marquee--reverse .marquee__track {
    animation: marquee-reverse 55s linear infinite;
  }

  .marquee__item {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    padding: 0.4rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .marquee__item span {
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--color-text-muted, rgba(255, 255, 255, 0.25));
    white-space: nowrap;
    letter-spacing: 0.03em;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .stack-tab[data-active="true"] {
    color: var(--color-primary, #ff6b35);
    border-color: var(--color-primary, #ff6b35);
  }
</style>

<script>
  // Tab highlight on click (scrolls to row)
  document.querySelectorAll<HTMLElement>('.stack-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.stack-tab').forEach(t => t.removeAttribute('data-active'));
      tab.setAttribute('data-active', 'true');
      const idx = tab.dataset.tab;
      const row = document.querySelector(`[data-row="${idx}"]`);
      if (row) row.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });

  // Scroll reveal
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const rows = entry.target.querySelectorAll('.stack-row');
          rows.forEach((row, i) => {
            setTimeout(() => {
              (row as HTMLElement).style.opacity = '1';
              (row as HTMLElement).style.transform = 'translateY(0)';
            }, i * 100);
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.05 }
  );

  const section = document.getElementById('tech-stack');
  if (section) {
    section.querySelectorAll('.stack-row').forEach((row) => {
      (row as HTMLElement).style.opacity = '0';
      (row as HTMLElement).style.transform = 'translateY(16px)';
      (row as HTMLElement).style.transition = 'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    observer.observe(section);
  }
</script>
