---
const team = [
  {
    name: 'Alex Morgan',
    role: 'Co-founder & CEO',
    bio: 'Full-stack engineer with a passion for building scalable systems and leading technical teams.',
    linkedin: '#',
    initials: 'AM',
  },
  {
    name: 'Jordan Lee',
    role: 'Co-founder & CTO',
    bio: 'Systems architect specializing in cloud infrastructure, AI/ML, and high-performance applications.',
    linkedin: '#',
    initials: 'JL',
  },
  {
    name: 'Sam Rivera',
    role: 'Lead Engineer',
    bio: 'Frontend specialist focused on modern web technologies, design systems, and user experience.',
    linkedin: '#',
    initials: 'SR',
  },
];
---

<section id="team" class="px-6 py-32">
  <div class="mx-auto max-w-[1440px] px-0 md:px-8">
    <div class="mb-20">
      <span class="text-xs font-mono text-primary/70 uppercase tracking-widest mb-4 block">Team</span>
      <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-start">
        <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          Engineers who<br />build and ship
        </h2>
        <div class="lg:pt-4">
          <p class="text-sm leading-relaxed text-text-secondary max-w-md">
            We are a small, focused team of engineers who write code, ship products, and solve real problems. No layers of management, just builders.
          </p>
        </div>
      </div>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {team.map((member, i) => (
        <div
          class="group relative border border-border/30 overflow-hidden transition-all duration-300 hover:border-primary/30 team-card"
          data-index={i}
        >
          <div class="aspect-[4/5] bg-gradient-to-br from-surface-elevated to-surface relative overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center text-6xl font-bold text-white/5">
              {member.initials}
            </div>
          </div>
          
          <div class="p-6">
            <h3 class="text-lg font-semibold mb-1 transition-colors duration-300 group-hover:text-primary">
              {member.name}
            </h3>
            <p class="text-xs text-primary/70 font-medium mb-3">{member.role}</p>
            <p class="text-xs text-text-muted leading-relaxed mb-4">
              {member.bio}
            </p>
            
            <a
              href={member.linkedin}
              class="inline-flex items-center gap-2 text-xs text-text-secondary transition-colors hover:text-primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              Connect
            </a>
          </div>
          
          <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-gradient-to-r from-primary to-transparent transition-all duration-500 group-hover:w-full"></div>
        </div>
      ))}
    </div>

    <div class="mt-16 border-t border-border/30 pt-12 text-center">
      <h3 class="text-xl font-semibold mb-3">Want to join us?</h3>
      <p class="text-sm text-text-muted mb-6 max-w-md mx-auto">
        We are always looking for talented engineers who are passionate about building great products.
      </p>
      <a
        href="#contact"
        class="inline-flex items-center gap-2 border border-primary/30 px-6 py-3 text-sm font-medium text-primary transition-all duration-300 hover:bg-primary hover:text-white"
      >
        Get in touch
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const cards = entry.target.querySelectorAll('.team-card');
          cards.forEach((card, i) => {
            setTimeout(() => {
              (card as HTMLElement).style.opacity = '1';
              (card as HTMLElement).style.transform = 'translateY(0)';
            }, i * 80);
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  const section = document.getElementById('team');
  if (section) {
    section.querySelectorAll('.team-card').forEach((card) => {
      (card as HTMLElement).style.opacity = '0';
      (card as HTMLElement).style.transform = 'translateY(20px)';
      (card as HTMLElement).style.transition = 'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    observer.observe(section);
  }
</script>
