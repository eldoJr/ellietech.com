---
import ProfileCard from '../../ui/profile-card.astro';
---

<section id="team" class="px-6 py-32">
  <div class="mx-auto max-w-[1440px] md:px-8">
    <!-- Header -->
    <div class="mb-20">
      <span class="text-xs font-mono text-primary/70 uppercase tracking-widest mb-4 block">Team</span>
      <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-start">
        <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          The engineers behind<br />the product
        </h2>
        <div class="lg:pt-4">
          <p class="text-sm leading-relaxed text-text-secondary max-w-md">
            A small, focused team of builders who write code, ship products, and solve real problems. No layers of management — just engineering.
          </p>
        </div>
      </div>
    </div>

    <!-- Team grid -->
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 justify-items-center">
      <!-- Real profile card -->
      <div class="team-card" data-index="0">
        <ProfileCard
          name="Eldo António Macuácua"
          position="Founder & Lead Engineer"
          academic="BSc Information Technology"
          avatarUrl="/images/me.png"
          bio="Full-stack engineer building modern web platforms, mobile applications, and scalable digital infrastructure."
          linkedin="https://www.linkedin.com/in/eldomacuacua"
          github="https://github.com/eldoJr"
          portfolio="https://eldomacuacua-github.vercel.app"
        />
      </div>

      <!-- Skeleton placeholder 1 -->
      <div class="team-card skeleton-card" data-index="1">
        <div class="skeleton-wrap">
          <div class="skeleton-image"><div class="skeleton-shimmer"></div></div>
          <div class="skeleton-content">
            <h3 class="skeleton-name">Jane Doe</h3>
            <p class="skeleton-position">Senior Frontend Engineer</p>
            <p class="skeleton-bio">Crafting pixel-perfect interfaces and design systems with React, TypeScript, and modern CSS.</p>
            <p class="skeleton-academic">BSc Computer Science</p>
            <div class="skeleton-links">
              <div class="skeleton-icon"></div>
              <div class="skeleton-icon"></div>
            </div>
          </div>
          <div class="skeleton-label"><span>Coming soon</span></div>
        </div>
      </div>

      <!-- Skeleton placeholder 2 -->
      <div class="team-card skeleton-card" data-index="2">
        <div class="skeleton-wrap">
          <div class="skeleton-image"><div class="skeleton-shimmer"></div></div>
          <div class="skeleton-content">
            <h3 class="skeleton-name">John Doe</h3>
            <p class="skeleton-position">Backend & Cloud Engineer</p>
            <p class="skeleton-bio">Building scalable APIs, microservices, and cloud infrastructure with Node.js, Python, and AWS.</p>
            <p class="skeleton-academic">MSc Software Engineering</p>
            <div class="skeleton-links">
              <div class="skeleton-icon"></div>
              <div class="skeleton-icon"></div>
            </div>
          </div>
          <div class="skeleton-label"><span>Coming soon</span></div>
        </div>
      </div>
    </div>

    <!-- Join CTA -->
    <div class="mt-20 border-t border-border/30 pt-12 text-center">
      <h3 class="text-xl font-semibold mb-3">Want to join us?</h3>
      <p class="text-sm text-text-muted mb-6 max-w-md mx-auto">
        We are always looking for talented engineers who are passionate about building great products.
      </p>
      <a
        href="#contact"
        class="inline-flex items-center gap-2 border border-primary/30 px-6 py-3 text-sm font-medium text-primary transition-all duration-300 hover:bg-primary hover:text-white"
      >
        Get in touch
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  .skeleton-wrap {
    position: relative;
    max-width: 320px;
    width: 100%;
  }

  .skeleton-shimmer {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.02) 50%, transparent 100%);
    animation: shimmer 3s infinite ease-in-out;
  }

  .skeleton-image {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    background: rgba(255, 255, 255, 0.03);
    overflow: hidden;
  }

  .skeleton-content {
    padding: 1.5rem 0.25rem;
  }

  .skeleton-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.15);
    margin: 0;
    line-height: 1.3;
  }

  .skeleton-position {
    font-size: 0.85rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.1);
    margin: 0.35rem 0 0;
  }

  .skeleton-bio {
    font-size: 0.8rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.08);
    margin: 1rem 0 0;
  }

  .skeleton-academic {
    font-size: 0.7rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.07);
    margin: 0.75rem 0 0;
  }

  .skeleton-links {
    display: flex;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .skeleton-icon {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
  }

  .skeleton-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .skeleton-label span {
    font-size: 10px;
    font-family: monospace;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.1);
  }

  .skeleton-card {
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .skeleton-card:hover {
    opacity: 0.85;
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const cards = entry.target.querySelectorAll('.team-card');
          cards.forEach((card, i) => {
            setTimeout(() => {
              (card as HTMLElement).style.opacity = '1';
              (card as HTMLElement).style.transform = 'translateY(0)';
            }, i * 150);
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  const section = document.getElementById('team');
  if (section) {
    section.querySelectorAll('.team-card').forEach((card) => {
      (card as HTMLElement).style.opacity = '0';
      (card as HTMLElement).style.transform = 'translateY(24px)';
      (card as HTMLElement).style.transition = 'opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    observer.observe(section);
  }
</script>
