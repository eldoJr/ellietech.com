---
const values = [
  {
    number: '01',
    title: 'Code quality matters',
    description: 'Clean, maintainable, well-tested code. We write software that lasts, scales, and can be handed off without a manual.',
    keywords: ['Readability', 'Testing', 'Documentation'],
  },
  {
    number: '02',
    title: 'Ship early, ship often',
    description: 'Real feedback beats perfect planning. We get working software in front of users fast, then iterate based on actual behavior.',
    keywords: ['Iteration', 'Feedback loops', 'Continuous delivery'],
  },
  {
    number: '03',
    title: 'User-first always',
    description: 'Every feature decision starts with user needs, not technical preferences. If it does not serve the user, it does not ship.',
    keywords: ['Empathy', 'Accessibility', 'Simplicity'],
  },
  {
    number: '04',
    title: 'Innovation over convention',
    description: 'We challenge assumptions and explore new approaches. The best solution is rarely the most obvious one.',
    keywords: ['Experimentation', 'Research', 'Curiosity'],
  },
  {
    number: '05',
    title: 'Ownership & accountability',
    description: 'Every engineer owns their work end-to-end. From architecture to deployment to monitoring — no hand-offs, no excuses.',
    keywords: ['Responsibility', 'Autonomy', 'Trust'],
  },
  {
    number: '06',
    title: 'Grow together',
    description: 'Knowledge sharing, code reviews, and honest feedback make everyone better. We invest in each other as much as in the product.',
    keywords: ['Mentorship', 'Collaboration', 'Learning'],
  },
];
---

<section id="values" class="px-6 py-32">
  <div class="mx-auto max-w-[1440px] md:px-8">

    <!-- Header — right-aligned for variety -->
    <div class="mb-24 flex flex-col items-end text-right max-w-xl ml-auto">
      <span class="text-xs font-mono text-primary/70 uppercase tracking-widest mb-4 block">Our Values</span>
      <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl mb-6">
        What drives us<br />every day
      </h2>
      <p class="text-sm leading-relaxed text-text-secondary">
        These principles shape how we build products, work with clients, and grow as engineers. They are non-negotiable.
      </p>
    </div>

    <!-- Values — alternating left/right layout -->
    <div class="space-y-0">
      {values.map((value, i) => (
        <div
          class:list={[
            'value-card group grid gap-6 lg:gap-12 py-10 border-t border-border/20',
            i % 2 === 0 ? 'lg:grid-cols-[auto_1fr_1.2fr]' : 'lg:grid-cols-[auto_1.2fr_1fr]',
          ]}
          data-index={i}
        >
          {/* Number */}
          <div class="flex items-start">
            <span class="text-3xl font-bold text-border/40 group-hover:text-primary font-mono leading-none">{value.number}</span>
          </div>

          {/* Title + keywords */}
          {i % 2 === 0 ? (
            <>
              <div>
                <h3 class="text-xl font-semibold text-text-primary group-hover:text-primary leading-tight">{value.title}</h3>
                <div class="flex flex-wrap gap-2 mt-3">
                  {value.keywords.map((kw) => (
                    <span class="text-[10px] font-mono text-text-muted/50 uppercase tracking-wider">{kw}</span>
                  ))}
                </div>
              </div>
              <div class="lg:pt-1">
                <p class="text-sm text-text-secondary leading-relaxed">{value.description}</p>
              </div>
            </>
          ) : (
            <>
              <div class="lg:pt-1">
                <p class="text-sm text-text-secondary leading-relaxed">{value.description}</p>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-text-primary group-hover:text-primary leading-tight">{value.title}</h3>
                <div class="flex flex-wrap gap-2 mt-3">
                  {value.keywords.map((kw) => (
                    <span class="text-[10px] font-mono text-text-muted/50 uppercase tracking-wider">{kw}</span>
                  ))}
                </div>
              </div>
            </>
          )}
        </div>
      ))}

      {/* Bottom border */}
      <div class="border-t border-border/20"></div>
    </div>

  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const cards = entry.target.querySelectorAll('.value-card');
          cards.forEach((card, i) => {
            setTimeout(() => {
              (card as HTMLElement).style.opacity = '1';
              (card as HTMLElement).style.transform = 'translateY(0)';
            }, i * 80);
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.05 }
  );

  const section = document.getElementById('values');
  if (section) {
    section.querySelectorAll('.value-card').forEach((card) => {
      (card as HTMLElement).style.opacity = '0';
      (card as HTMLElement).style.transform = 'translateY(12px)';
      (card as HTMLElement).style.transition = 'opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    observer.observe(section);
  }
</script>
