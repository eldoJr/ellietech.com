---
---

<section class="relative min-h-[60vh] flex flex-col justify-center overflow-hidden bg-[#1a1a1a] dark:bg-[#0f0f0f]">
  <!-- Diagonal lines background -->
  <div class="absolute inset-0 opacity-[0.08] dark:opacity-[0.05]">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="diagonal-lines" x="0" y="0" width="80" height="80" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="80" y2="80" stroke="currentColor" stroke-width="0.5" class="text-white"/>
          <line x1="0" y1="40" x2="40" y2="80" stroke="currentColor" stroke-width="0.5" class="text-white"/>
          <line x1="40" y1="0" x2="80" y2="40" stroke="currentColor" stroke-width="0.5" class="text-white"/>
          <line x1="-20" y1="20" x2="20" y2="60" stroke="currentColor" stroke-width="0.5" class="text-white"/>
          <line x1="60" y1="-20" x2="100" y2="20" stroke="currentColor" stroke-width="0.5" class="text-white"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#diagonal-lines)"/>
    </svg>
  </div>

  <!-- Content -->
  <div class="relative z-10 mx-auto w-full max-w-[1440px] px-6 md:px-8 py-24 lg:py-32">
    <!-- Breadcrumb -->
    <nav class="mb-12 flex items-center gap-2 text-xs text-text-muted">
      <a href="/" class="transition-colors hover:text-primary">Home</a>
      <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="text-text-secondary">About us</span>
    </nav>

    <!-- Title with underline -->
    <div class="max-w-4xl">
      <h1 class="text-5xl font-bold leading-tight tracking-tight sm:text-6xl lg:text-7xl mb-6 text-white">
        About us
      </h1>
      <div class="h-[2px] w-24 bg-primary mb-8"></div>
      
      <p class="text-base text-white/80 leading-relaxed max-w-3xl lg:text-lg mb-4">
        EllieTech is a full-stack software startup specializing in modern web platforms, mobile applications, AI-powered systems, and scalable digital infrastructure.
      </p>
      <p class="text-base text-white/80 leading-relaxed max-w-3xl lg:text-lg">
        We design and engineer high-performance digital products with a strong focus on innovation, user experience, and modern technologies.
      </p>
    </div>
  </div>
</section>

<style>
  h1 {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  p {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s backwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
