---
import DarkVeil from '../ui/dark-veil.astro';
import DotField from '../dot-field.tsx';
---

<section class="relative flex min-h-screen items-center overflow-hidden">
  <!-- WebGL Background -->
  <div class="pointer-events-none absolute inset-0 h-full w-full">
    <DarkVeil speed={0.3} hueShift={0} noiseIntensity={0.02} warpAmount={0.3} resolutionScale={0.75} />
    <div class="absolute inset-0 bg-gradient-to-b from-surface/40 via-surface/30 to-surface/80"></div>
  </div>

  <!-- Dot pattern layer -->
  <div class="absolute inset-0 z-[1] pointer-events-none">
    <div style="width:100%;height:100%;position:relative;">
      <DotField
        client:load
        dotRadius={1.5}
        dotSpacing={14}
        cursorRadius={500}
        cursorForce={0.1}
        bulgeOnly
        bulgeStrength={67}
        glowRadius={160}
        sparkle={false}
        waveAmplitude={0}
        gradientFrom="rgba(168, 85, 247, 0.35)"
        gradientTo="rgba(180, 151, 207, 0.25)"
        glowColor="#120F17"
      />
    </div>
  </div>

  <!-- Hero content -->
  <div class="relative z-[2] mx-auto w-full max-w-[1440px] px-6 md:px-8 pt-32 pb-20 lg:pt-40 lg:pb-28">
    <div>
      <div>
        <!-- Action pills -->
        <div class="mb-8 inline-flex items-center gap-1 p-[3px] border border-primary/30 bg-white/[0.02] backdrop-blur-md shadow-lg shadow-black/20 rounded-sm">
          <a href="#services" class="bg-primary px-4 py-1.5 text-xs font-medium text-white transition-colors hover:bg-primary-light rounded-[2px]">
            Full-cycle development
          </a>
          <a href="#work" class="group flex items-center gap-1.5 px-4 py-1.5 text-xs font-medium text-text-secondary transition-colors hover:text-text-primary rounded-[2px]">
            Explore our work
            <svg class="h-3 w-3 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <h1 class="mb-10 text-4xl font-bold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl xl:text-7xl">
          We engineer
          <span class="bg-gradient-to-r from-primary via-primary-light to-accent bg-clip-text text-transparent">
            digital systems
          </span>
          <br />
          that scale.
        </h1>

        <!-- CTA + description row -->
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
          <a
            href="#contact"
            class="group inline-flex items-center gap-2 bg-primary px-7 py-3.5 text-sm font-medium text-white transition-all duration-200 hover:bg-primary-light hover:shadow-xl hover:shadow-primary/20 rounded-sm flex-shrink-0"
          >
            Start a project
            <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <p class="max-w-md text-sm leading-relaxed text-text-muted">
            To build impactful digital systems that shape the future of technology, business, and human interaction.
          </p>
        </div>

        <!-- Service hub cards -->
        <div class="mt-16 grid grid-cols-3 divide-x divide-white/[0.06] border-b border-white/[0.06]">
          <a href="#services" class="hero-card group relative overflow-hidden p-6 transition-all duration-500 ease-out hover:bg-black">
            <div class="absolute -top-12 -right-12 h-24 w-24 bg-primary/10 blur-2xl opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
            <span class="text-[10px] font-mono text-text-muted/50 uppercase tracking-wider">Fig 0.1</span>
            <div class="relative my-5 flex justify-center">
              <img src="/src/assets/icons/card-02.svg" alt="" class="h-32 w-auto opacity-80 transition-all duration-500 group-hover:opacity-100 group-hover:scale-105" />
            </div>
            <h3 class="text-base font-semibold text-text-primary mb-2 text-center transition-colors duration-300 group-hover:text-primary">Web & Mobile</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-3 text-center">End-to-end development of SaaS platforms, progressive web apps, and cross-platform mobile applications with modern UI/UX principles.</p>
            <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-out group-hover:grid-rows-[1fr]">
              <div class="overflow-hidden">
                <div class="flex flex-wrap justify-center gap-1.5 pt-4 border-t border-white/[0.04]">
                  <span class="px-2 py-0.5 text-[10px] text-text-muted border border-white/[0.08] rounded-sm">Next.js</span>
                  <span class="px-2 py-0.5 text-[10px] text-text-muted border border-white/[0.08] rounded-sm">React Native</span>
                  <span class="px-2 py-0.5 text-[10px] text-text-muted border border-white/[0.08] rounded-sm">Flutter</span>
                  <span class="px-2 py-0.5 text-[10px] text-text-muted border border-white/[0.08] rounded-sm">Node.js</span>
                </div>
              </div>
            </div>
            <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-gradient-to-r from-primary via-primary-light to-transparent transition-all duration-500 group-hover:w-full"></div>
          </a>

          <a href="#services" class="hero-card group relative overflow-hidden p-6 transition-all duration-500 ease-out hover:bg-black">
            <div class="absolute -top-12 -right-12 h-24 w-24 bg-primary/10 blur-2xl opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
            <span class="text-[10px] font-mono text-text-muted/50 uppercase tracking-wider">Fig 0.2</span>
            <div class="relative my-5 flex justify-center">
              <img src="/src/assets/icons/card-01.svg" alt="" class="h-32 w-auto opacity-80 transition-all duration-500 group-hover:opacity-100 group-hover:scale-105" />
            </div>
            <h3 class="text-base font-semibold text-text-primary mb-2 text-center transition-colors duration-300 group-hover:text-primary">AI & Automation</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-3 text-center">Custom AI solutions from LLM integration and intelligent automation to predictive analytics and computer vision systems for enterprise workflows.</p>
            <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-out group-hover:grid-rows-[1fr]">
              <div class="overflow-hidden">
                <div class="flex flex-wrap justify-center gap-1.5 pt-4 border-t border-white/[0.04]">
                  <span class="px-2 py-0.5 text-[10px] text-text-muted border border-white/[0.08] rounded-sm">OpenAI</span>
                  <span class="px-2 py-0.5 text-[10px] text-text-muted border border-white/[0.08] rounded-sm">LangChain</span>
                  <span class="px-2 py-0.5 text-[10px] text-text-muted border border-white/[0.08] rounded-sm">Python</span>
                  <span class="px-2 py-0.5 text-[10px] text-text-muted border border-white/[0.08] rounded-sm">TensorFlow</span>
                </div>
              </div>
            </div>
            <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-gradient-to-r from-primary via-primary-light to-transparent transition-all duration-500 group-hover:w-full"></div>
          </a>

          <a href="#services" class="hero-card group relative overflow-hidden p-6 transition-all duration-500 ease-out hover:bg-black">
            <div class="absolute -top-12 -right-12 h-24 w-24 bg-primary/10 blur-2xl opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
            <span class="text-[10px] font-mono text-text-muted/50 uppercase tracking-wider">Fig 0.3</span>
            <div class="relative my-5 flex justify-center">
              <img src="/src/assets/icons/card-03.svg" alt="" class="h-32 w-auto opacity-80 transition-all duration-500 group-hover:opacity-100 group-hover:scale-105" />
            </div>
            <h3 class="text-base font-semibold text-text-primary mb-2 text-center transition-colors duration-300 group-hover:text-primary">Cloud & Scale</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-3 text-center">Production-grade cloud infrastructure, CI/CD pipelines, container orchestration, and auto-scaling architecture for high-availability systems.</p>
            <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-out group-hover:grid-rows-[1fr]">
              <div class="overflow-hidden">
                <div class="flex flex-wrap justify-center gap-1.5 pt-4 border-t border-white/[0.04]">
                  <span class="px-2 py-0.5 text-[10px] text-text-muted border border-white/[0.08] rounded-sm">AWS</span>
                  <span class="px-2 py-0.5 text-[10px] text-text-muted border border-white/[0.08] rounded-sm">Kubernetes</span>
                  <span class="px-2 py-0.5 text-[10px] text-text-muted border border-white/[0.08] rounded-sm">Terraform</span>
                  <span class="px-2 py-0.5 text-[10px] text-text-muted border border-white/[0.08] rounded-sm">Docker</span>
                </div>
              </div>
            </div>
            <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-gradient-to-r from-primary via-primary-light to-transparent transition-all duration-500 group-hover:w-full"></div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
