---
import DarkVeil from '../ui/dark-veil.astro';
import DotField from '../dot-field.tsx';
---

<section class="relative min-h-screen flex flex-col justify-center overflow-hidden">
  <!-- WebGL Background (both modes) -->
  <div class="pointer-events-none absolute inset-0 h-full w-full">
    <DarkVeil speed={0.3} hueShift={0} noiseIntensity={0.02} warpAmount={0.3} resolutionScale={0.75} />
    <!-- Dark mode overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-surface/20 to-surface/60 dark:block hidden"></div>
    <!-- Light mode overlay — washes out the shader to blend with white -->
    <div class="absolute inset-0 bg-gradient-to-b from-white/70 via-white/60 to-white/90 dark:hidden block"></div>
  </div>

  <!-- Light mode extra gradient accents -->
  <div class="pointer-events-none absolute inset-0 h-full w-full dark:hidden block">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(255,87,51,0.06),transparent_50%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(6,182,212,0.04),transparent_50%)]"></div>
  </div>

  <!-- Dot pattern layer (both modes, different colors) -->
  <div class="absolute inset-0 z-[1] pointer-events-none">
    <div style="width:100%;height:100%;position:relative;">
      <DotField
        client:load
        dotRadius={1.5}
        dotSpacing={14}
        cursorRadius={500}
        cursorForce={0.1}
        bulgeOnly
        bulgeStrength={67}
        glowRadius={160}
        sparkle={false}
        waveAmplitude={0}
        gradientFrom="rgba(168, 85, 247, 0.25)"
        gradientTo="rgba(180, 151, 207, 0.18)"
        glowColor="rgba(0,0,0,0.03)"
      />
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-[2] mx-auto w-full max-w-[1440px] px-6 md:px-8 pt-36 pb-24 lg:pt-44 lg:pb-32">

    <!-- Top: Eyebrow -->
    <div class="mb-6 flex items-center gap-3">
      <div class="h-[1px] w-8 bg-primary/60"></div>
      <span class="text-[11px] font-mono text-primary/80 uppercase tracking-[0.2em]">Software Engineering Studio</span>
    </div>

    <!-- Headline -->
    <h1 class="text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl xl:text-[5.5rem] max-w-5xl hero-title">
      <span class="block">We engineer</span>
      <span class="block bg-gradient-to-r from-primary via-primary-light to-accent bg-clip-text text-transparent">digital systems</span>
      <span class="block">that scale.</span>
    </h1>

    <!-- Subtext + CTA -->
    <div class="mt-10 flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between lg:gap-16">
      <!-- Left: description -->
      <p class="text-base text-text-secondary leading-relaxed max-w-md">
        We deliver fast, scalable, and intelligent software solutions through modern engineering and minimalist design principles — from concept to global deployment.
      </p>

      <!-- Right: CTAs stacked -->
      <div class="flex flex-col gap-3 sm:flex-row sm:gap-4 lg:flex-col lg:items-end">
        <a
          href="#contact"
          class="group inline-flex items-center justify-center gap-2 bg-primary px-10 py-4 text-sm font-medium text-white transition-all duration-300 hover:bg-primary-light hover:shadow-xl hover:shadow-primary/20 rounded-sm min-w-[200px]"
        >
          Start a project
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="#work"
          class="group inline-flex items-center justify-center gap-2 px-10 py-4 text-sm text-text-secondary border border-white/[0.08] transition-all duration-300 hover:border-white/[0.15] hover:text-text-primary rounded-sm min-w-[200px]"
        >
          View our work
          <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Pillars -->
    <div class="mt-8 pt-6 border-t border-white/[0.04] dark:border-white/[0.04] border-black/[0.06]">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-0 sm:divide-x sm:divide-white/[0.06] pillar-grid">
        <div class="group py-5 sm:pr-8 pillar-item">
          <div class="flex items-center gap-3 mb-3">
            <span class="flex h-7 w-7 items-center justify-center border border-primary/20 text-[9px] font-mono text-primary">01</span>
            <h4 class="text-sm font-semibold text-text-primary transition-colors duration-300 group-hover:text-primary">Ship Fast</h4>
          </div>
          <p class="text-[11px] text-text-muted leading-relaxed pl-10">MVP to production in 4-6 weeks. Focused scope, proven patterns, zero wasted cycles.</p>
        </div>
        <div class="group py-5 sm:px-8 pillar-item">
          <div class="flex items-center gap-3 mb-3">
            <span class="flex h-7 w-7 items-center justify-center border border-accent/20 text-[9px] font-mono text-accent">02</span>
            <h4 class="text-sm font-semibold text-text-primary transition-colors duration-300 group-hover:text-accent">Scale Smart</h4>
          </div>
          <p class="text-[11px] text-text-muted leading-relaxed pl-10">Architecture designed for 10x growth from day one. No rewrites, no bottlenecks.</p>
        </div>
        <div class="group py-5 sm:pl-8 pillar-item">
          <div class="flex items-center gap-3 mb-3">
            <span class="flex h-7 w-7 items-center justify-center border border-green-400/20 text-[9px] font-mono text-green-400">03</span>
            <h4 class="text-sm font-semibold text-text-primary transition-colors duration-300 group-hover:text-green-400">Stay Secure</h4>
          </div>
          <p class="text-[11px] text-text-muted leading-relaxed pl-10">Enterprise-grade compliance built in. HIPAA, PCI DSS, SOC 2 ready.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-[2] flex flex-col items-center gap-2">
    <span class="text-[9px] font-mono text-text-muted/30 uppercase tracking-[0.3em]">Scroll</span>
    <div class="relative h-8 w-[1px] overflow-hidden bg-white/[0.04]">
      <div class="absolute top-0 left-0 w-full h-3 bg-gradient-to-b from-primary/60 to-transparent animate-scroll-down"></div>
    </div>
  </div>
</section>

<style>
  @keyframes scrollDown {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(300%); }
  }

  .animate-scroll-down {
    animation: scrollDown 2.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .hero-title span {
    opacity: 0;
    transform: translateY(20px);
    animation: heroReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-title span:nth-child(1) { animation-delay: 0.1s; }
  .hero-title span:nth-child(2) { animation-delay: 0.25s; }
  .hero-title span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes heroReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .pillar-item {
    opacity: 0;
    transform: translateY(12px);
    animation: pillarIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .pillar-item:nth-child(1) { animation-delay: 0.6s; }
  .pillar-item:nth-child(2) { animation-delay: 0.75s; }
  .pillar-item:nth-child(3) { animation-delay: 0.9s; }

  @keyframes pillarIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
