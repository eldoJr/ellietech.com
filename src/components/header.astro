---
import { SITE } from '../lib/constants';
import NavDropdown from './ui/nav-dropdown.astro';

const topLinks = [
  { label: 'Full-Stack', href: '#services' },
  { label: 'Data & AI', href: '#services' },
  { label: 'Cloud & Infra', href: '#services' },
];

const aboutLinks = {
  col1: [
    { label: 'How we work', href: '#about' },
    { label: 'Quality management', href: '#about' },
    { label: 'Corporate responsibility', href: '#about' },
    { label: 'Leadership', href: '#about' },
    { label: 'Blog', href: '/blog' },
    { label: 'Expert tips', href: '/blog' },
  ],
  col2: [
    { label: 'Testimonials', href: '#testimonials' },
    { label: 'Tech partners', href: '#about' },
    { label: 'Certifications', href: '#about' },
    { label: 'Events', href: '#about' },
    { label: 'Newsroom', href: '/blog' },
    { label: 'Careers', href: '#contact' },
  ],
};

const servicesLeft = {
  title: 'Full-cycle software development services',
  col1: [
    'IT consulting & advisory',
    'Web development',
    'Mobile development',
    'Embedded software development',
    'Custom software development',
    'MVP development',
    'Cloud development',
    'ERP development',
    'Mainframe support',
    'Legacy modernization',
  ],
  col2: [
    'UI/UX design',
    '3D design',
    'Software testing and QA',
    'Security testing',
    'Database administration',
    'DevOps',
    'DevSecOps',
    'Network',
    'IT staff augmentation',
    'Dedicated team',
  ],
};

const servicesRight = {
  title: 'Advanced technologies implementation',
  col1: [
    'Big data',
    'Data management',
    'Data analytics',
    'Data engineering',
    'Data visualization',
    'Business intelligence',
    'Machine learning',
    'Artificial intelligence',
    'Data science',
    'Sustainability & ESG',
  ],
  col2: [
    'Digital transformation',
    'Business process automation',
    'Robotic process automation',
    'Cybersecurity',
    'Internet of things',
    'Blockchain',
    'NFT',
    'Metaverse',
    'AR & VR',
  ],
};
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">

  <!-- Main nav -->
  <div id="main-nav" class="relative" style="background: transparent; border: 1px solid transparent; border-radius: 0; margin: 0; box-shadow: none; transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);">
    <!-- Mouse-follow glow -->
    <div id="nav-glow" class="pointer-events-none absolute inset-0 z-[1] overflow-hidden rounded-[inherit] opacity-0 transition-opacity duration-500" style="background: radial-gradient(400px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255,87,51,0.12), transparent 60%);"></div>
    <nav class="relative z-[2] mx-auto flex max-w-[1440px] items-stretch px-6 md:px-8">
      <!-- Logo -->
      <a href="/" class="mr-auto flex items-center flex-shrink-0 py-3">
        <img src="/logo.svg" alt={SITE.name} class="h-7 w-auto sm:h-8" />
      </a>

      <!-- Desktop nav links -->
      <ul class="hidden items-stretch gap-6 xl:gap-8 lg:flex" id="desktop-nav">
        <!-- About us -->
        <li class="flex items-stretch">
          <NavDropdown label="About us" href="#about">
            <div class="grid grid-cols-[1fr_1.5fr_1fr_1fr] gap-8">
              <div class="border border-border/30 overflow-hidden">
                <img src="/logo.svg" alt="EllieTech" class="h-full w-full object-contain bg-surface-elevated p-6" />
              </div>
              <div class="flex items-start">
                <p class="text-sm leading-relaxed text-text-secondary">
                  EllieTech is a full-cycle software development company. We are a team of IT professionals developing software for other professionals worldwide.
                </p>
              </div>
              <ul class="flex flex-col gap-3">
                {aboutLinks.col1.map((link) => (
                  <li>
                    <a href={link.href} class="text-sm text-text-secondary transition-colors hover:text-primary">{link.label}</a>
                  </li>
                ))}
              </ul>
              <ul class="flex flex-col gap-3">
                {aboutLinks.col2.map((link) => (
                  <li>
                    <a href={link.href} class="text-sm text-text-secondary transition-colors hover:text-primary">{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          </NavDropdown>
        </li>

        <!-- Services -->
        <li class="flex items-stretch">
          <NavDropdown label="Services" href="#services">
            <div class="grid grid-cols-2 gap-10">
              <div>
                <h3 class="mb-5 text-sm font-semibold text-text-primary">{servicesLeft.title}</h3>
                <div class="grid grid-cols-2 gap-x-6 border-l border-border/50 pl-5">
                  <ul class="flex flex-col gap-3">
                    {servicesLeft.col1.map((item) => (
                      <li><a href="#services" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                    ))}
                  </ul>
                  <ul class="flex flex-col gap-3">
                    {servicesLeft.col2.map((item) => (
                      <li><a href="#services" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                    ))}
                  </ul>
                </div>
              </div>
              <div>
                <h3 class="mb-5 text-sm font-semibold text-text-primary">{servicesRight.title}</h3>
                <div class="grid grid-cols-2 gap-x-6 border-l border-border/50 pl-5">
                  <ul class="flex flex-col gap-3">
                    {servicesRight.col1.map((item) => (
                      <li><a href="#services" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                    ))}
                  </ul>
                  <ul class="flex flex-col gap-3">
                    {servicesRight.col2.map((item) => (
                      <li><a href="#services" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </NavDropdown>
        </li>

        <!-- Technologies -->
        <li class="flex items-stretch">
          <NavDropdown label="Technologies" href="#tech-stack">
            <div class="grid grid-cols-5 gap-8">
              <div>
                <h4 class="mb-4 text-xs font-semibold uppercase tracking-wider text-text-muted">Front-end</h4>
                <ul class="flex flex-col gap-2.5 border-l border-border/50 pl-4">
                  {['React', 'Angular', 'Vue.js', 'JavaScript', 'TypeScript', 'Next.js'].map((item) => (
                    <li><a href="#tech-stack" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 class="mb-4 text-xs font-semibold uppercase tracking-wider text-text-muted">Back-end</h4>
                <ul class="flex flex-col gap-2.5 border-l border-border/50 pl-4">
                  {['Java', '.NET', 'Python', 'PHP', 'Rust', 'C/C++', 'Node.js', 'Ruby', 'Golang'].map((item) => (
                    <li><a href="#tech-stack" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 class="mb-4 text-xs font-semibold uppercase tracking-wider text-text-muted">Mobile</h4>
                <ul class="flex flex-col gap-2.5 border-l border-border/50 pl-4">
                  {['iOS', 'Android', 'Flutter', 'React Native', 'Swift', 'Kotlin'].map((item) => (
                    <li><a href="#tech-stack" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 class="mb-4 text-xs font-semibold uppercase tracking-wider text-text-muted">Cloud</h4>
                <ul class="flex flex-col gap-2.5 border-l border-border/50 pl-4">
                  {['AWS', 'Azure', 'GCP', 'Docker', 'Kubernetes', 'Terraform'].map((item) => (
                    <li><a href="#tech-stack" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 class="mb-4 text-xs font-semibold uppercase tracking-wider text-text-muted">ERP & CRM</h4>
                <ul class="flex flex-col gap-2.5 border-l border-border/50 pl-4">
                  {['SAP', 'MS Dynamics 365', 'Odoo', 'Salesforce', 'HubSpot'].map((item) => (
                    <li><a href="#tech-stack" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                  ))}
                </ul>
              </div>
            </div>
          </NavDropdown>
        </li>

        <!-- Industries -->
        <li class="flex items-stretch">
          <NavDropdown label="Industries" href="#industries">
            <div class="grid grid-cols-4 gap-8">
              <ul class="flex flex-col gap-3">
                {['Finance', 'Banking', 'Trading', 'Insurance', 'eCommerce', 'Retail'].map((item) => (
                  <li><a href="#work" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                ))}
              </ul>
              <ul class="flex flex-col gap-3">
                {['Healthcare', 'Pharmaceutics', 'Education', 'Telecommunications', 'Media & Entertainment'].map((item) => (
                  <li><a href="#work" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                ))}
              </ul>
              <ul class="flex flex-col gap-3">
                {['Enterprise', 'Manufacturing', 'Automotive', 'Logistics', 'Transportation', 'Marketing'].map((item) => (
                  <li><a href="#work" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                ))}
              </ul>
              <ul class="flex flex-col gap-3">
                {['Government', 'Energy & Utilities', 'Oil & Gas', 'Construction', 'Real Estate', 'Agriculture'].map((item) => (
                  <li><a href="#work" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                ))}
              </ul>
            </div>
          </NavDropdown>
        </li>

        <!-- Portfolio -->
        <li class="flex items-stretch">
          <NavDropdown label="Portfolio" href="#work">
            <div class="grid grid-cols-2 gap-12 max-w-2xl mx-auto">
              <div>
                <h3 class="mb-5 text-sm font-semibold text-text-primary">Case studies</h3>
                <div class="grid grid-cols-2 gap-x-6 border-l border-border/50 pl-5">
                  <ul class="flex flex-col gap-3">
                    {['Banking', 'Finance', 'Healthcare', 'Pharma'].map((item) => (
                      <li><a href="#work" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                    ))}
                  </ul>
                  <ul class="flex flex-col gap-3">
                    {['eCommerce', 'Retail', 'Manufacturing', 'Enterprise'].map((item) => (
                      <li><a href="#work" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                    ))}
                  </ul>
                </div>
              </div>
              <div>
                <h3 class="mb-5 text-sm font-semibold text-text-primary">Our platforms</h3>
                <ul class="flex flex-col gap-3 border-l border-border/50 pl-5">
                  {['Applicant tracking system (ATS)', 'HRM system', 'Learning management system (LMS)', 'Workspace booking system'].map((item) => (
                    <li><a href="#work" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                  ))}
                </ul>
              </div>
            </div>
          </NavDropdown>
        </li>

        <!-- Hire us -->
        <li class="flex items-stretch">
          <NavDropdown label="Hire us" href="#contact">
            <div class="grid grid-cols-4 gap-8">
              <div>
                <h4 class="mb-4 text-xs font-semibold uppercase tracking-wider text-text-muted">Dedicated developers</h4>
                <ul class="flex flex-col gap-2.5 border-l border-border/50 pl-4">
                  {['IT staff augmentation', 'Dedicated teams', 'Offshore developers'].map((item) => (
                    <li><a href="#contact" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 class="mb-4 text-xs font-semibold uppercase tracking-wider text-text-muted">Web developers</h4>
                <ul class="flex flex-col gap-2.5 border-l border-border/50 pl-4">
                  {['Angular', 'React.js', 'Vue.js', '.NET', 'Java', 'PHP', 'Python', 'Golang'].map((item) => (
                    <li><a href="#contact" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 class="mb-4 text-xs font-semibold uppercase tracking-wider text-text-muted">Mobile developers</h4>
                <ul class="flex flex-col gap-2.5 border-l border-border/50 pl-4">
                  {['iOS', 'Android', 'Kotlin', 'React Native', 'Swift'].map((item) => (
                    <li><a href="#contact" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 class="mb-4 text-xs font-semibold uppercase tracking-wider text-text-muted">Other engineers</h4>
                <ul class="flex flex-col gap-2.5 border-l border-border/50 pl-4">
                  {['AI', 'Cloud', 'AWS', 'Azure', 'DevOps', 'QA', 'SAP', 'Salesforce'].map((item) => (
                    <li><a href="#contact" class="text-xs text-text-secondary transition-colors hover:text-primary">{item}</a></li>
                  ))}
                </ul>
              </div>
            </div>
          </NavDropdown>
        </li>
      </ul>

      <!-- Right: CTA + Theme + Search + Lang -->
      <div class="hidden items-center gap-4 ml-6 lg:flex">
        <a
          href="#contact"
          class="bg-primary px-5 py-2.5 text-xs font-medium text-white transition-all duration-200 hover:bg-primary-light hover:shadow-lg hover:shadow-primary/20"
        >
          Contact us
        </a>
        
        <!-- Theme toggle -->
        <button
          id="theme-toggle"
          aria-label="Toggle theme"
          class="relative p-2 rounded-xl transition-colors text-text-secondary hover:bg-surface-elevated hover:text-text-primary cursor-pointer"
        >
          <div class="relative w-[18px] h-[18px]">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <div id="theme-slash" class="absolute inset-0 flex items-center justify-center transition-opacity opacity-0">
              <div class="w-[22px] h-[1.5px] bg-current rotate-45 rounded-full"></div>
            </div>
          </div>
        </button>

        <button id="search-open-btn" aria-label="Search" class="p-1.5 text-text-secondary transition-colors duration-200 hover:text-text-primary cursor-pointer">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
        <div class="relative" id="lang-switcher">
          <button id="lang-btn" class="flex items-center gap-1.5 text-xs font-medium text-text-secondary transition-colors duration-200 hover:text-text-primary cursor-pointer">
            <svg class="h-3.5 w-3.5 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9" />
            </svg>
            EN
            <svg class="h-2.5 w-2.5 transition-transform duration-200" id="lang-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div id="lang-dropdown" class="hidden absolute right-0 top-full mt-4 w-56 bg-[#111116] border border-white/[0.08] shadow-[0_12px_40px_rgba(0,0,0,0.6)] z-50 py-3 px-3 lang-dropdown-enter">
            <p class="text-[9px] font-mono text-text-muted/40 uppercase tracking-wider mb-2 px-1">Select language</p>
            <div class="grid grid-cols-2 gap-1">
              <a href="#" class="flex items-center gap-2 px-2.5 py-2 text-xs transition-all duration-200 hover:bg-white/[0.04] border border-primary/20 bg-primary/[0.03]"><span class="font-semibold text-primary">EN</span><span class="text-text-secondary">English</span></a>
              <a href="#" class="flex items-center gap-2 px-2.5 py-2 text-xs transition-all duration-200 hover:bg-white/[0.04]"><span class="font-medium text-text-primary">DE</span><span class="text-text-muted">Deutsch</span></a>
              <a href="#" class="flex items-center gap-2 px-2.5 py-2 text-xs transition-all duration-200 hover:bg-white/[0.04]"><span class="font-medium text-text-primary">FR</span><span class="text-text-muted">Français</span></a>
              <a href="#" class="flex items-center gap-2 px-2.5 py-2 text-xs transition-all duration-200 hover:bg-white/[0.04]"><span class="font-medium text-text-primary">ES</span><span class="text-text-muted">Español</span></a>
              <a href="#" class="flex items-center gap-2 px-2.5 py-2 text-xs transition-all duration-200 hover:bg-white/[0.04]"><span class="font-medium text-text-primary">IT</span><span class="text-text-muted">Italiano</span></a>
              <a href="#" class="flex items-center gap-2 px-2.5 py-2 text-xs transition-all duration-200 hover:bg-white/[0.04]"><span class="font-medium text-text-primary">PT</span><span class="text-text-muted">Português</span></a>
              <a href="#" class="flex items-center gap-2 px-2.5 py-2 text-xs transition-all duration-200 hover:bg-white/[0.04]"><span class="font-medium text-text-primary">NL</span><span class="text-text-muted">Nederlands</span></a>
              <a href="#" class="flex items-center gap-2 px-2.5 py-2 text-xs transition-all duration-200 hover:bg-white/[0.04]"><span class="font-medium text-text-primary">PL</span><span class="text-text-muted">Polski</span></a>
              <a href="#" class="flex items-center gap-2 px-2.5 py-2 text-xs transition-all duration-200 hover:bg-white/[0.04]"><span class="font-medium text-text-primary">SV</span><span class="text-text-muted">Svenska</span></a>
              <a href="#" class="flex items-center gap-2 px-2.5 py-2 text-xs transition-all duration-200 hover:bg-white/[0.04]"><span class="font-medium text-text-primary">NB</span><span class="text-text-muted">Norsk</span></a>
            </div>
          </div>
        </div>
      </div>

      <!-- Search overlay (compact, replaces nav on open) -->
      <div id="search-bar" class="hidden items-center ml-auto gap-3 w-full max-w-[600px]">
        <svg class="h-4 w-4 text-text-muted flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="Search..."
          class="flex-1 bg-transparent border-b border-border/50 py-1.5 text-sm text-text-primary placeholder:text-text-muted outline-none focus:border-primary transition-colors"
        />
        <button id="search-close-btn" aria-label="Close search" class="p-1.5 text-text-muted transition-colors hover:text-text-primary flex-shrink-0">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="flex items-center justify-center p-2 text-text-secondary lg:hidden"
        aria-label="Toggle menu"
      >
        <svg id="menu-icon-open" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="fixed inset-x-0 top-0 bottom-0 z-[200] hidden bg-surface overflow-y-auto lg:hidden">
    <!-- Mobile header -->
    <div class="flex items-center justify-between border-b border-border/50 px-6 py-3">
      <a href="/" class="flex-shrink-0">
        <img src="/logo.svg" alt={SITE.name} class="h-7 w-auto" />
      </a>
      <button id="mobile-close-btn" class="p-2 text-text-secondary" aria-label="Close menu">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile nav content -->
    <div class="px-6 py-6 space-y-1">
      <a href="#about" class="block py-3 text-sm text-text-secondary border-b border-border/30 transition-colors active:text-primary">About us</a>
      <a href="#services" class="block py-3 text-sm text-text-secondary border-b border-border/30 transition-colors active:text-primary">Services</a>
      <a href="#tech-stack" class="block py-3 text-sm text-text-secondary border-b border-border/30 transition-colors active:text-primary">Technologies</a>
      <a href="#industries" class="block py-3 text-sm text-text-secondary border-b border-border/30 transition-colors active:text-primary">Industries</a>
      <a href="#work" class="block py-3 text-sm text-text-secondary border-b border-border/30 transition-colors active:text-primary">Portfolio</a>
      <a href="#contact" class="flex items-center gap-2 py-3 text-sm text-text-secondary border-b border-border/30 transition-colors active:text-primary">
        <svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Hire us
      </a>

      <div class="pt-6">
        <a href="#contact" class="block w-full bg-primary py-3 text-center text-sm font-medium text-white transition-colors hover:bg-primary-light">
          Contact us
        </a>
      </div>

      <!-- Mobile language selector -->
      <div class="pt-6 border-t border-white/[0.06] mt-6">
        <div class="flex items-center gap-2 mb-4">
          <svg class="h-4 w-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9" />
          </svg>
          <p class="text-xs text-text-muted uppercase tracking-wider font-medium">Language</p>
        </div>
        <div class="grid grid-cols-4 gap-2">
          <button class="py-2.5 text-xs font-medium text-primary border border-primary/30 bg-primary/5 text-center">EN</button>
          <button class="py-2.5 text-xs text-text-secondary border border-white/[0.06] text-center transition-colors active:border-primary/30 active:text-primary">DE</button>
          <button class="py-2.5 text-xs text-text-secondary border border-white/[0.06] text-center transition-colors active:border-primary/30 active:text-primary">FR</button>
          <button class="py-2.5 text-xs text-text-secondary border border-white/[0.06] text-center transition-colors active:border-primary/30 active:text-primary">ES</button>
          <button class="py-2.5 text-xs text-text-secondary border border-white/[0.06] text-center transition-colors active:border-primary/30 active:text-primary">IT</button>
          <button class="py-2.5 text-xs text-text-secondary border border-white/[0.06] text-center transition-colors active:border-primary/30 active:text-primary">PT</button>
          <button class="py-2.5 text-xs text-text-secondary border border-white/[0.06] text-center transition-colors active:border-primary/30 active:text-primary">NL</button>
          <button class="py-2.5 text-xs text-text-secondary border border-white/[0.06] text-center transition-colors active:border-primary/30 active:text-primary">PL</button>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* Transparent by default — blends with hero */
  #site-header {
    background: transparent;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #main-nav {
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Glass fade in */
  #site-header.header-scrolled #nav-glass,
  #site-header.header-hover #nav-glass,
  #site-header.header-dropdown-open #nav-glass {
    opacity: 1 !important;
  }

  /* Dock effect — handled by JS direct style */
  #main-nav {
    will-change: background, border-radius, margin, border-color, box-shadow, backdrop-filter;
  }

  @media (min-width: 1024px) {
    /* placeholder for responsive — JS handles values */
  }

  /* Solid bg on scroll */
  #site-header.header-scrolled {
    background: transparent;
  }

  /* Solid bg on hover */
  #site-header.header-hover {
    background: transparent;
  }

  /* Solid bg when dropdown is open */
  #site-header.header-dropdown-open {
    background: transparent;
  }

  /* Bottom line on main-nav */
  #main-nav::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.06), transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  #site-header.header-scrolled #main-nav::after,
  #site-header.header-hover #main-nav::after,
  #site-header.header-dropdown-open #main-nav::after {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    #site-header {
      animation: headerSlideDown 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    #site-header #desktop-nav > li {
      animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    }

    #site-header #desktop-nav > li:nth-child(1) { animation-delay: 0.08s; }
    #site-header #desktop-nav > li:nth-child(2) { animation-delay: 0.12s; }
    #site-header #desktop-nav > li:nth-child(3) { animation-delay: 0.16s; }
    #site-header #desktop-nav > li:nth-child(4) { animation-delay: 0.20s; }
    #site-header #desktop-nav > li:nth-child(5) { animation-delay: 0.24s; }
    #site-header #desktop-nav > li:nth-child(6) { animation-delay: 0.28s; }
  }

  @keyframes headerSlideDown {
    from { opacity: 0; transform: translateY(-100%); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Mobile menu animation */
  #mobile-menu.is-open {
    display: block;
    animation: mobileSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes mobileSlideIn {
    from { opacity: 0; transform: translateX(100%); }
    to { opacity: 1; transform: translateX(0); }
  }
</style>

<script>
  // Mobile menu
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileCloseBtn = document.getElementById('mobile-close-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  const openMobile = () => {
    mobileMenu?.classList.remove('hidden');
    mobileMenu?.classList.add('is-open');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  };

  const closeMobile = () => {
    mobileMenu?.classList.add('hidden');
    mobileMenu?.classList.remove('is-open');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    document.body.style.overflow = '';
  };

  mobileBtn?.addEventListener('click', openMobile);
  mobileCloseBtn?.addEventListener('click', closeMobile);

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMobile);
  });

  // Search toggle
  const searchOpenBtn = document.getElementById('search-open-btn');
  const searchCloseBtn = document.getElementById('search-close-btn');
  const searchBar = document.getElementById('search-bar');
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const desktopNav = document.getElementById('desktop-nav');
  const rightActions = searchOpenBtn?.closest('.lg\\:flex') as HTMLElement;

  const openSearch = () => {
    desktopNav?.classList.add('!hidden');
    rightActions?.classList.add('!hidden');
    searchBar?.classList.remove('hidden');
    searchBar?.classList.add('flex');
    searchInput?.focus();
  };

  const closeSearch = () => {
    searchBar?.classList.add('hidden');
    searchBar?.classList.remove('flex');
    desktopNav?.classList.remove('!hidden');
    rightActions?.classList.remove('!hidden');
  };

  searchOpenBtn?.addEventListener('click', openSearch);
  searchCloseBtn?.addEventListener('click', closeSearch);
  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSearch();
  });

  // Language switcher
  const langBtn = document.getElementById('lang-btn');
  const langDropdown = document.getElementById('lang-dropdown');
  const langChevron = document.getElementById('lang-chevron');

  langBtn?.addEventListener('click', () => {
    const isHidden = langDropdown?.classList.toggle('hidden');
    if (langChevron) {
      langChevron.style.transform = isHidden ? 'rotate(0deg)' : 'rotate(180deg)';
    }
  });

  document.addEventListener('click', (e) => {
    if (!document.getElementById('lang-switcher')?.contains(e.target as Node)) {
      langDropdown?.classList.add('hidden');
      if (langChevron) langChevron.style.transform = 'rotate(0deg)';
    }
  });

  // Scroll behavior
  let lastScroll = 0;
  const header = document.getElementById('site-header');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;

    if (currentScroll > 50) {
      header?.classList.add('header-scrolled');
      dockIn();
    } else {
      header?.classList.remove('header-scrolled');
      if (!header?.classList.contains('header-hover')) dockOut();
    }

    if (!prefersReducedMotion && currentScroll > 100) {
      if (currentScroll > lastScroll && currentScroll - lastScroll > 5) {
        header?.style.setProperty('transform', 'translateY(-100%)');
      } else if (lastScroll - currentScroll > 5) {
        header?.style.setProperty('transform', 'translateY(0)');
      }
    }
    lastScroll = currentScroll;
  }, { passive: true });

  if (header && !prefersReducedMotion) {
    header.style.transition = 'transform 0.3s cubic-bezier(0.16, 1, 0.3, 1)';
  }

  // Toggle header bg when dropdown opens
  const observer = new MutationObserver(() => {
    const anyOpen = document.querySelector('.nav-dropdown-trigger.is-open');
    if (anyOpen) {
      header?.classList.add('header-dropdown-open');
    } else {
      header?.classList.remove('header-dropdown-open');
    }
  });

  const navContainer = document.getElementById('desktop-nav');
  if (navContainer) {
    observer.observe(navContainer, { subtree: true, attributes: true, attributeFilter: ['class'] });
  }

  // Direct style dock animation (Framer Motion style)
  const mainNav = document.getElementById('main-nav');
  const navGlow = document.getElementById('nav-glow');
  const isLg = () => window.innerWidth >= 1024;

  function dockIn() {
    if (!mainNav) return;
    mainNav.style.background = 'linear-gradient(135deg, rgba(25, 25, 35, 0.98), rgba(15, 15, 22, 0.98))';
    mainNav.style.backdropFilter = 'blur(20px)';
    (mainNav.style as any).webkitBackdropFilter = 'blur(20px)';
    mainNav.style.borderRadius = '14px';
    mainNav.style.margin = isLg() ? '10px 40px' : '8px 16px';
    mainNav.style.borderColor = 'rgba(255, 255, 255, 0.1)';
    mainNav.style.boxShadow = '0 4px 24px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.03) inset';
  }

  function dockOut() {
    if (!mainNav) return;
    mainNav.style.background = 'transparent';
    mainNav.style.backdropFilter = 'none';
    (mainNav.style as any).webkitBackdropFilter = 'none';
    mainNav.style.borderRadius = '0';
    mainNav.style.margin = '0';
    mainNav.style.borderColor = 'transparent';
    mainNav.style.boxShadow = 'none';
  }

  header?.addEventListener('mouseenter', () => {
    if (!header.classList.contains('header-scrolled')) {
      header.classList.add('header-hover');
    }
    dockIn();
  });

  header?.addEventListener('mouseleave', () => {
    header?.classList.remove('header-hover');
    if (!header?.classList.contains('header-scrolled') && !header?.classList.contains('header-dropdown-open')) {
      dockOut();
    }
  });

  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  const themeSlash = document.getElementById('theme-slash');
  
  const updateTheme = () => {
    const isDark = document.documentElement.classList.contains('dark');
    if (themeSlash) {
      themeSlash.style.opacity = isDark ? '1' : '0';
    }
  };
  
  themeToggle?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    const isDark = document.documentElement.classList.contains('dark');
    localStorage.setItem('ellietech_theme', isDark ? 'dark' : 'light');
    updateTheme();
  });
  
  // Initialize theme on load
  updateTheme();

  // Nav glow follow mouse
  mainNav?.addEventListener('mousemove', (e) => {
    const rect = mainNav.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    mainNav.style.setProperty('--mouse-x', `${x}px`);
    mainNav.style.setProperty('--mouse-y', `${y}px`);
  });

  mainNav?.addEventListener('mouseenter', () => {
    navGlow?.classList.remove('opacity-0');
    navGlow?.classList.add('opacity-100');
  });

  mainNav?.addEventListener('mouseleave', () => {
    navGlow?.classList.add('opacity-0');
    navGlow?.classList.remove('opacity-100');
  });
</script>
