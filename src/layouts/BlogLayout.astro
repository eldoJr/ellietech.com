---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, heroImage, tags = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — EllieTech Blog`} description={description}>
  <Header />
  <main class="px-6 pb-32 pt-32">
    <article class="mx-auto max-w-3xl">
      <header class="mb-12">
        <div class="mb-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
              {tag}
            </span>
          ))}
        </div>
        <h1 class="mb-4 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
        <p class="mb-4 text-lg text-text-secondary">{description}</p>
        <time class="text-sm text-text-muted" datetime={pubDate.toISOString()}>
          {formattedDate}
        </time>
        {updatedDate && (
          <span class="ml-4 text-sm text-text-muted">
            (Updated: {updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })})
          </span>
        )}
      </header>

      {heroImage && (
        <img
          src={heroImage}
          alt={title}
          class="mb-12 w-full rounded-2xl border border-border/50"
        />
      )}

      <div class="prose prose-invert prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-primary prose-code:rounded prose-code:bg-surface-elevated prose-code:px-1.5 prose-code:py-0.5 prose-code:text-sm prose-pre:rounded-xl prose-pre:border prose-pre:border-border/50 prose-pre:bg-surface-light">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
